{"ast":null,"code":"export default {\n  name: 'FuelGauge',\n  props: {\n    modelValue: {\n      type: Number,\n      default: 50\n    },\n    disabled: {\n      type: Boolean,\n      default: false\n    }\n  },\n  emits: ['update:modelValue'],\n  computed: {\n    fuelColor() {\n      if (this.modelValue <= 25) return '#ef4444';\n      if (this.modelValue <= 50) return '#f59e0b';\n      return '#22c55e';\n    }\n  }\n};","map":{"version":3,"names":["name","props","modelValue","type","Number","default","disabled","Boolean","emits","computed","fuelColor"],"sources":["D:\\frontend_cem\\src\\components\\FuelGauge.vue"],"sourcesContent":["<template>\r\n  <div class=\"fuel-gauge-container\">\r\n    <div class=\"fuel-gauge\">\r\n      <div class=\"fuel-icon\">\r\n        <i class=\"pi pi-bolt\"></i>\r\n      </div>\r\n      <div class=\"gauge-body\">\r\n        <div class=\"gauge-fill\" :style=\"{ width: modelValue + '%', backgroundColor: fuelColor }\"></div>\r\n        <div class=\"gauge-marks\">\r\n          <span class=\"mark major\" v-for=\"n in 9\" :key=\"'major'+n\" :style=\"{ left: ((n-1) * 12.5) + '%' }\"></span>\r\n          <span class=\"mark minor\" v-for=\"n in 17\" :key=\"'minor'+n\" :style=\"{ left: ((n-1) * 6.25) + '%' }\"></span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"gauge-labels\">\r\n      <span>E</span>\r\n      <span>1/4</span>\r\n      <span>1/2</span>\r\n      <span>3/4</span>\r\n      <span>F</span>\r\n    </div>\r\n    <input \r\n      type=\"range\" \r\n      :value=\"modelValue\" \r\n      @input=\"$emit('update:modelValue', Number($event.target.value))\"\r\n      min=\"0\" \r\n      max=\"100\" \r\n      step=\"5\"\r\n      class=\"fuel-slider\"\r\n      :disabled=\"disabled\"\r\n    />\r\n    <div class=\"fuel-value\">{{ modelValue }}%</div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'FuelGauge',\r\n  props: {\r\n    modelValue: { type: Number, default: 50 },\r\n    disabled: { type: Boolean, default: false }\r\n  },\r\n  emits: ['update:modelValue'],\r\n  computed: {\r\n    fuelColor() {\r\n      if (this.modelValue <= 25) return '#ef4444'\r\n      if (this.modelValue <= 50) return '#f59e0b'\r\n      return '#22c55e'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.fuel-gauge-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  padding: 1rem;\r\n  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);\r\n  border-radius: 12px;\r\n  border: 2px solid #334155;\r\n}\r\n\r\n.fuel-gauge {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  width: 100%;\r\n}\r\n\r\n.gauge-body {\r\n  flex: 1;\r\n  height: 32px;\r\n  background: #0f172a;\r\n  border-radius: 6px;\r\n  border: 2px solid #475569;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n\r\n.gauge-fill {\r\n  height: 100%;\r\n  transition: width 0.3s ease, background-color 0.3s ease;\r\n  border-radius: 4px;\r\n}\r\n\r\n.gauge-marks {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n}\r\n\r\n.mark {\r\n  position: absolute;\r\n  bottom: 0;\r\n  background: rgba(255,255,255,0.5);\r\n}\r\n\r\n.mark.major {\r\n  width: 2px;\r\n  height: 100%;\r\n}\r\n\r\n.mark.minor {\r\n  width: 1px;\r\n  height: 50%;\r\n}\r\n\r\n.gauge-labels {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  width: 100%;\r\n  padding: 0 40px 0 0;\r\n  font-size: 0.75rem;\r\n  color: #94a3b8;\r\n  font-weight: 600;\r\n}\r\n\r\n.fuel-icon {\r\n  width: 32px;\r\n  height: 32px;\r\n  background: #334155;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: #fbbf24;\r\n  font-size: 1rem;\r\n}\r\n\r\n.fuel-slider {\r\n  width: 100%;\r\n  margin-top: 0.5rem;\r\n  -webkit-appearance: none;\r\n  height: 8px;\r\n  background: #334155;\r\n  border-radius: 4px;\r\n  outline: none;\r\n}\r\n\r\n.fuel-slider::-webkit-slider-thumb {\r\n  -webkit-appearance: none;\r\n  width: 20px;\r\n  height: 20px;\r\n  background: #3b82f6;\r\n  border-radius: 50%;\r\n  cursor: pointer;\r\n  border: 2px solid #fff;\r\n}\r\n\r\n.fuel-slider:disabled {\r\n  opacity: 0.6;\r\n}\r\n\r\n.fuel-slider:disabled::-webkit-slider-thumb {\r\n  cursor: not-allowed;\r\n}\r\n\r\n.fuel-value {\r\n  color: #fff;\r\n  font-size: 1.25rem;\r\n  font-weight: 700;\r\n}\r\n</style>\r\n"],"mappings":"AAoCA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,KAAK,EAAE;IACLC,UAAU,EAAE;MAAEC,IAAI,EAAEC,MAAM;MAAEC,OAAO,EAAE;IAAG,CAAC;IACzCC,QAAQ,EAAE;MAAEH,IAAI,EAAEI,OAAO;MAAEF,OAAO,EAAE;IAAM;EAC5C,CAAC;EACDG,KAAK,EAAE,CAAC,mBAAmB,CAAC;EAC5BC,QAAQ,EAAE;IACRC,SAASA,CAAA,EAAG;MACV,IAAI,IAAI,CAACR,UAAS,IAAK,EAAE,EAAE,OAAO,SAAQ;MAC1C,IAAI,IAAI,CAACA,UAAS,IAAK,EAAE,EAAE,OAAO,SAAQ;MAC1C,OAAO,SAAQ;IACjB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}