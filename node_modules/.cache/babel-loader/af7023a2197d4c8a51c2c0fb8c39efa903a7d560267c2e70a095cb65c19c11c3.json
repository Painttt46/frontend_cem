ode(\"option\", {\n      value: \"highlight\"\n    }, \"โดดเด่น\", -1 /* CACHED */), _createElementVNode(\"option\", {\n      value: \"warning\"\n    }, \"เตือน\", -1 /* CACHED */), _createElementVNode(\"option\", {\n      value: \"info\"\n    }, \"ข้อมูล\", -1 /* CACHED */)]))], 512 /* NEED_PATCH */), [[_vModelSelect, $setup.newAnnouncement.type]])]), _createElementVNode(\"div\", _hoisted_7, [_createElementVNode(\"button\", {\n      onClick: $setup.submitAnnouncement,\n      class: \"submit-btn\",\n      disabled: !$setup.newAnnouncement.text.trim() || $setup.isSubmitting\n    }, [$setup.isSubmitting ? (_openBlock(), _createElementBlock(\"span\", _hoisted_9, \"กำลังบันทึก...\")) : (_openBlock(), _createElementBlock(\"span\", _hoisted_10, \"บันทึกประกาศ\"))], 8 /* PROPS */, _hoisted_8), _createElementVNode(\"button\", {\n      onClick: $setup.clearForm,\n      class: \"clear-btn\"\n    }, \"ล้าง\")])]), $setup.successMessage ? (_openBlock(), _createElementBlock(\"div\", _hoisted_11, _toDisplayString($setup.successMessage), 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true), $setup.errorMessage ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, _toDisplayString($setup.errorMessage), 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true)])) : _createCommentVNode(\"v-if\", true)]),\n    _: 1 /* STABLE */\n  })]);\n}","map":{"version":3,"names":["class","_createElementBlock","_hoisted_1","_createElementVNode","_normalizeClass","$setup","isExpanded","onClick","toggleInput","_createVNode","_Transition","name","_hoisted_2","_hoisted_3","_hoisted_4","newAnnouncement","icon","$event","value","_hoisted_5","text","placeholder","rows","_hoisted_6","type","_hoisted_7","submitAnnouncement","disabled","trim","isSubmitting","_hoisted_9","_hoisted_10","clearForm","successMessage","_hoisted_11","_toDisplayString","errorMessage","_hoisted_12"],"sources":["D:\\frontend_cem\\src\\components\\AnnouncementInput.vue"],"sourcesContent":["<template>\n  <div class=\"announcement-input-container\">\n    <button \n      class=\"announcement-toggle-btn\"\n      @click=\"toggleInput\"\n      :class=\"{ 'active': isExpanded }\"\n    >\n      <i class=\"pi pi-megaphone\"></i>\n    </button>\n    \n    <transition name=\"slide-up\">\n      <div v-if=\"isExpanded\" class=\"announcement-input-panel\">\n        <div class=\"input-header\">\n          <h3>เพิ่มประกาศใหม่</h3>\n          <button class=\"close-btn\" @click=\"toggleInput\">×</button>\n        </div>\n        \n        <div class=\"input-form\">\n          <div class=\"form-group\">\n            <label>ไอคอน:</label>\n            <select v-model=\"newAnnouncement.icon\" class=\"icon-select\">\n              <option value=\"📢\">📢 ประกาศ</option>\n              <option value=\"⚠️\">⚠️ เตือน</option>\n              <option value=\"✨\">✨ ใหม่</option>\n              <option value=\"🚀\">🚀 อัปเดต</option>\n              <option value=\"📅\">📅 กำหนดการ</option>\n              <option value=\"🎉\">🎉 สำเร็จ</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ข้อความ:</label>\n            <textarea \n              v-model=\"newAnnouncement.text\"\n              placeholder=\"กรอกข้อความประกาศ...\"\n              class=\"message-textarea\"\n              rows=\"3\"\n            ></textarea>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ประเภท:</label>\n            <select v-model=\"newAnnouncement.type\" class=\"type-select\">\n              <option value=\"\">ปกติ</option>\n              <option value=\"highlight\">โดดเด่น</option>\n              <option value=\"warning\">เตือน</option>\n              <option value=\"info\">ข้อมูล</option>\n            </select>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button \n              @click=\"submitAnnouncement\"\n              class=\"submit-btn\"\n              :disabled=\"!newAnnouncement.text.trim() || isSubmitting\"\n            >\n              <span v-if=\"isSubmitting\">กำลังบันทึก...</span>\n              <span v-else>บันทึกประกาศ</span>\n            </button>\n            <button @click=\"clearForm\" class=\"clear-btn\">ล้าง</button>\n          </div>\n        </div>\n        \n        <div v-if=\"successMessage\" class=\"success-message\">\n          {{ successMessage }}\n        </div>\n        \n        <div v-if=\"errorMessage\" class=\"error-message\">\n          {{ errorMessage }}\n        </div>\n      </div>\n    </transition>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst isExpanded = ref(false)\nconst isSubmitting = ref(false)\nconst successMessage = ref('')\nconst errorMessage = ref('')\n\nconst newAnnouncement = ref({\n  icon: '📢',\n  text: '',\n  type: ''\n})\n\nconst toggleInput = () => {\n  isExpanded.value = !isExpanded.value\n  if (!isExpanded.value) {\n    clearForm()\n  }\n}\n\nconst clearForm = () => {\n  newAnnouncement.value = {\n    icon: '📢',\n    text: '',\n    type: ''\n  }\n  successMessage.value = ''\n  errorMessage.value = ''\n}\n\nconst submitAnnouncement = async () => {\n  if (!newAnnouncement.value.text.trim()) {\n    errorMessage.value = 'กรุณากรอกข้อความประกาศ'\n    return\n  }\n  \n  isSubmitting.value = true\n  errorMessage.value = ''\n  \n  try {\n    // ส่งข้อมูลไปยัง API\n    const response = await fetch('/api/announcements', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n      },\n      body: JSON.stringify({\n        icon: newAnnouncement.value.icon,\n        text: newAnnouncement.value.text,\n        type: newAnnouncement.value.type,\n        tag: 'h4' // กำหนด tag เป็น h4 เสมอ\n      })\n    })\n    \n    if (response.ok) {\n      successMessage.value = 'บันทึกประกาศเรียบร้อยแล้ว!'\n      clearForm()\n      \n      // ปิดช่องพิมพ์หลังจากบันทึกสำเร็จ\n      setTimeout(() => {\n        isExpanded.value = false\n        successMessage.value = ''\n      }, 2000)\n    } else {\n      throw new Error('ไม่สามารถบันทึกประกาศได้')\n    }\n  } catch (error) {\n    console.error('Error submitting announcement:', error)\n    errorMessage.value = 'เกิดข้อผิดพลาด กรุณาลองใหม่'\n  } finally {\n    isSubmitting.value = false\n  }\n}\n</script>\n\n<style scoped>\n.announcement-input-container {\n  position: fixed;\n  bottom: 90px;\n  right: 24px;\n  z-index: 1000;\n}\n\n.announcement-toggle-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border: none;\n  border-radius: 50%;\n  padding: 10px;\n  cursor: pointer;\n  font-size: 20px;\n  font-weight: 600;\n  box-shadow: 0 4px 15px rgba(74, 144, 226, 0.4);\n  transition: transform 0.2s;\n  backdrop-filter: blur(10px);\n  width: 48px;\n  height: 48px;\n  line-height: 1;\n}\n\n.announcement-toggle-btn:hover {\n  transform: scale(1.1);\n  box-shadow: 0 6px 16px rgba(74, 144, 226, 0.4);\n}\n\n.announcement-toggle-btn.active {\n  background: linear-gradient(135deg, #d73527 0%, #4a90e2 100%);\n}\n\n.announcement-toggle-btn i {\n  font-size: 20px;\n  line-height: 1;\n  display: block;\n}\n\n.announcement-input-panel {\n  position: absolute;\n  bottom: 60px;\n  right: 0;\n  background: white;\n  border-radius: 12px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\n  width: 320px;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.input-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  border-bottom: 1px solid #e0e0e0;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border-radius: 12px 12px 0 0;\n}\n\n.input-header h3 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.close-btn {\n  background: transparent;\n  border: none;\n  color: white;\n  font-size: 20px;\n  cursor: pointer;\n  padding: 4px 8px;\n  border-radius: 4px;\n  transition: background-color 0.3s ease;\n}\n\n.close-btn:hover {\n  background-color: rgba(255, 255, 255, 0.2);\n}\n\n.input-form {\n  padding: 16px;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 6px;\n  font-size: 14px;\n  font-weight: 500;\n  color: #333;\n}\n\n.icon-select,\n.type-select {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  font-size: 14px;\n  background: white;\n}\n\n.message-textarea {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  font-size: 14px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.message-textarea:focus {\n  outline: none;\n  border-color: #4a90e2;\n  box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);\n}\n\n.form-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.submit-btn {\n  flex: 1;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border: none;\n  border-radius: 6px;\n  padding: 10px 16px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.submit-btn:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\n}\n\n.submit-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.clear-btn {\n  background: #f5f5f5;\n  color: #666;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  padding: 10px 16px;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.clear-btn:hover {\n  background: #e0e0e0;\n}\n\n.success-message {\n  margin: 12px 16px;\n  padding: 8px 12px;\n  background: #d4edda;\n  color: #155724;\n  border-radius: 6px;\n  font-size: 14px;\n  text-align: center;\n}\n\n.error-message {\n  margin: 12px 16px;\n  padding: 8px 12px;\n  background: #f8d7da;\n  color: #721c24;\n  border-radius: 6px;\n  font-size: 14px;\n  text-align: center;\n}\n\n/* Animations */\n.slide-up-enter-active,\n.slide-up-leave-active {\n  transition: all 0.3s ease;\n}\n\n.slide-up-enter-from {\n  opacity: 0;\n  transform: translateY(20px);\n}\n\n.slide-up-leave-to {\n  opacity: 0;\n  transform: translateY(20px);\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .announcement-input-container {\n    bottom: 80px;\n    right: 10px;\n  }\n  \n  .announcement-input-panel {\n    width: 280px;\n  }\n}\n\n@media (max-width: 480px) {\n  .announcement-input-container {\n    bottom: 80px;\n    right: 16px;\n  }\n  \n  .announcement-input-panel {\n    width: 260px;\n  }\n  \n  .announcement-toggle-btn {\n    width: 48px;\n    height: 48px;\n    padding: 10px;\n  }\n  \n  .announcement-toggle-btn i {\n    font-size: 20px;\n    line-height: 1;\n    display: block;\n  }\n}\n</style>\n"],"mappings":";;EACOA,KAAK,EAAC;AAA8B;;;EAUdA,KAAK,EAAC;;;EAMtBA,KAAK,EAAC;AAAY;;EAChBA,KAAK,EAAC;AAAY;;EAYlBA,KAAK,EAAC;AAAY;;EAUlBA,KAAK,EAAC;AAAY;;EAUlBA,KAAK,EAAC;AAAc;;;;;;;;;;EAaAA,KAAK,EAAC;;;;EAIRA,KAAK,EAAC;;;uBAlErCC,mBAAA,CAuEM,OAvENC,UAuEM,GAtEJC,mBAAA,CAMS;IALPH,KAAK,EAAAI,eAAA,EAAC,yBAAyB;MAAA,UAEXC,MAAA,CAAAC;IAAU;IAD7BC,OAAK,EAAEF,MAAA,CAAAG;qCAGRL,mBAAA,CAA+B;IAA5BH,KAAK,EAAC;EAAiB,0B,qBAG5BS,YAAA,CA6DaC,WAAA;IA7DDC,IAAI,EAAC;EAAU;sBACzB,MA2DM,CA3DKN,MAAA,CAAAC,UAAU,I,cAArBL,mBAAA,CA2DM,OA3DNW,UA2DM,GA1DJT,mBAAA,CAGM;MAHDH,KAAK,EAAC;IAAc,I,0BACvBG,mBAAA,CAAwB,YAApB,iBAAe,qBACnBA,mBAAA,CAAyD;MAAjDH,KAAK,EAAC,WAAW;MAAEO,OAAK,EAAEF,MAAA,CAAAG;OAAa,GAAC,E,GAGlDL,mBAAA,CA4CM,OA5CNU,UA4CM,GA3CJV,mBAAA,CAUM,OAVNW,UAUM,G,0BATJX,mBAAA,CAAqB,eAAd,QAAM,qB,gBACbA,mBAAA,CAOS;iEAPQE,MAAA,CAAAU,eAAe,CAACC,IAAI,GAAAC,MAAA;MAAEjB,KAAK,EAAC;uCAC3CG,mBAAA,CAAqC;MAA7Be,KAAK,EAAC;IAAI,GAAC,WAAS,oBAC5Bf,mBAAA,CAAoC;MAA5Be,KAAK,EAAC;IAAI,GAAC,UAAQ,oBAC3Bf,mBAAA,CAAiC;MAAzBe,KAAK,EAAC;IAAG,GAAC,QAAM,oBACxBf,mBAAA,CAAqC;MAA7Be,KAAK,EAAC;IAAI,GAAC,WAAS,oBAC5Bf,mBAAA,CAAuC;MAA/Be,KAAK,EAAC;IAAI,GAAC,aAAW,oBAC9Bf,mBAAA,CAAqC;MAA7Be,KAAK,EAAC;IAAI,GAAC,WAAS,mB,6CANbb,MAAA,CAAAU,eAAe,CAACC,IAAI,E,KAUvCb,mBAAA,CAQM,OARNgB,UAQM,G,0BAPJhB,mBAAA,CAAuB,eAAhB,UAAQ,qB,gBACfA,mBAAA,CAKY;iEAJDE,MAAA