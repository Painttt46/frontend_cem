isted_6"],"sources":["D:\\frontend_cem\\src\\components\\AnnouncementBanner.vue"],"sourcesContent":["<template>\n  <transition name=\"banner-slide\">\n    <div v-if=\"isVisible\" class=\"announcement-banner\">\n      <div class=\"banner-content\">\n        <div class=\"banner-icon\">\n          <i class=\"pi pi-megaphone\"></i>\n        </div>\n        <div class=\"banner-text-container\">\n          <div class=\"banner-text-wrapper\">\n            <div class=\"banner-text\">\n              <h4>{{ title }}</h4>\n              <p>{{ message }}</p>\n            </div>\n            <div class=\"banner-text clone\">\n              <h4>{{ title }}</h4>\n              <p>{{ message }}</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </transition>\n</template>\n\n<script setup>\n/* eslint-disable */\nimport { ref, onMounted } from 'vue'\n\nconst props = defineProps({\n  title: {\n    type: String,\n    default: 'ประกาศ'\n  },\n  message: {\n    type: String,\n    default: 'ข้อความประกาศของคุณ'\n  },\n  autoHide: {\n    type: Boolean,\n    default: false\n  },\n  hideDelay: {\n    type: Number,\n    default: 5000\n  }\n})\n\nconst isVisible = ref(true)\n\nconst closeBanner = () => {\n  isVisible.value = false\n  // บันทึกสถานะการปิดลง localStorage\n  localStorage.setItem('announcementBannerClosed', 'true')\n}\n\nconst showBanner = () => {\n  isVisible.value = true\n  localStorage.removeItem('announcementBannerClosed')\n}\n\nonMounted(() => {\n  // เช็คว่าผู้ใช้เคยปิดป้ายประกาศไปหรือไม่\n  const wasClosed = localStorage.getItem('announcementBannerClosed')\n  if (wasClosed === 'true') {\n    isVisible.value = false\n  }\n\n  // ถ้าตั้งค่าให้ซ่อนอัตโนมัติ\n  if (props.autoHide) {\n    setTimeout(() => {\n      closeBanner()\n    }, props.hideDelay)\n  }\n})\n\n// เปิดให้ component อื่นเรียกใช้\ndefineExpose({\n  showBanner,\n  closeBanner\n})\n</script>\n\n<style scoped>\n.announcement-banner {\n  background: linear-gradient(135deg, rgba(74, 144, 226, 0.92) 0%, rgba(215, 53, 39, 0.92) 100%);\n  color: white;\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1100;\n  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);\n  backdrop-filter: blur(12px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.25);\n  animation: bannerGlow 4s ease-in-out infinite alternate;\n}\n\n@keyframes bannerGlow {\n  0% {\n    box-shadow: 0 6px 24px rgba(74, 144, 226, 0.25);\n  }\n  100% {\n    box-shadow: 0 6px 28px rgba(215, 53, 39, 0.3);\n  }\n}\n\n.banner-content {\n  display: flex;\n  align-items: center;\n  padding: 0 3rem;\n  gap: 1.5rem;\n  max-width: 100%;\n  height: 70px;\n}\n\n.banner-icon {\n  flex-shrink: 0;\n  font-size: 2.2rem;\n  filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.25));\n  animation: iconPulse 3s ease-in-out infinite;\n}\n\n@keyframes iconPulse {\n  0%, 100% {\n    transform: scale(1);\n    opacity: 0.9;\n  }\n  50% {\n    transform: scale(1.1);\n    opacity: 1;\n  }\n}\n\n.banner-text-container {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  position: relative;\n}\n\n.banner-text-wrapper {\n  display: flex;\n  animation: scrollText 15s linear infinite;\n  width: fit-content;\n}\n\n.banner-text {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n  padding-right: 4rem;\n}\n\n.banner-text.clone {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n}\n\n@keyframes scrollText {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n.banner-text h4 {\n  margin: 0 0 0.5rem 0;\n  font-size: 1.25rem;\n  font-weight: 600;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.25);\n  letter-spacing: 0.6px;\n  animation: textFade 2.5s ease-in-out infinite alternate;\n}\n\n.banner-text p {\n  margin: 0;\n  font-size: 1rem;\n  opacity: 0.95;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.25);\n  animation: textSlide 4s ease-in-out infinite;\n}\n\n@keyframes textFade {\n  0% {\n    opacity: 0.95;\n  }\n  100% {\n    opacity: 1;\n  }\n}\n\n@keyframes textSlide {\n  0%, 100% {\n    transform: translateX(0);\n  }\n  50% {\n    transform: translateX(2px);\n  }\n}\n\n/* Animation */\n.banner-slide-enter-active,\n.banner-slide-leave-active {\n  transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n}\n\n.banner-slide-enter-from {\n  transform: translateY(-100%) scale(0.95);\n  opacity: 0;\n}\n\n.banner-slide-leave-to {\n  transform: translateY(-100%) scale(0.95);\n  opacity: 0;\n}\n\n@keyframes pulse {\n  0% {\n    transform: scale(1);\n  }\n  50% {\n    transform: scale(1.05);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .banner-content {\n    padding: 0.75rem 1rem;\n  }\n  \n  .banner-icon {\n    font-size: 1.25rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 0.875rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.75rem;\n  }\n}\n\n@media (max-width: 480px) {\n  .banner-content {\n    padding: 0.5rem 0.75rem;\n    gap: 0.5rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 0.8rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.7rem;\n  }\n}\n</style>\n"],"mappings":";;;EAE0BA,KAAK,EAAC;;;EACrBA,KAAK,EAAC;AAAgB;;EAIpBA,KAAK,EAAC;AAAuB;;EAC3BA,KAAK,EAAC;AAAqB;;EACzBA,KAAK,EAAC;AAAa;;EAInBA,KAAK,EAAC;AAAmB;;uBAZxCC,YAAA,CAoBaC,WAAA;IApBDC,IAAI,EAAC;EAAc;sBAC7B,MAkBM,CAlBKC,MAAA,CAAAC,SAAS,I,cAApBC,mBAAA,CAkBM,OAlBNC,UAkBM,GAjBJC,mBAAA,CAgBM,OAhBNC,UAgBM,G,0BAfJD,mBAAA,CAEM;MAFDR,KAAK,EAAC;IAAa,IACtBQ,mBAAA,CAA+B;MAA5BR,KAAK,EAAC;IAAiB,G,qBAE5BQ,mBAAA,CAWM,OAXNE,UAWM,GAVJF,mBAAA,CASM,OATNG,UASM,GARJH,mBAAA,CAGM,OAHNI,UAGM,GAFJJ,mBAAA,CAAoB,YAAAK,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kBACZP,mBAAA,CAAoB,WAAAK,gBAAA,CAAdC,MAAA,CAAAE,OAAO,iB,GAEfR,mBAAA,CAGM,OAHNS,UAGM,GAFJT,mBAAA,CAAoB,YAAAK,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kBACZP,mBAAA,CAAoB,WAAAK,gBAAA,CAAdC,MAAA,CAAAE,OAAO,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}