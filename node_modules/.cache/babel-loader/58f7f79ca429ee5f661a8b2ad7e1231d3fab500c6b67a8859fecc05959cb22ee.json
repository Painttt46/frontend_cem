{"ast":null,"code":"import EasyPassCard from '@/components/EasyPassCard.vue';\nexport default {\n  name: 'CarCalendar',\n  components: {\n    EasyPassCard\n  },\n  props: {\n    records: Array,\n    availableBorrows: Array,\n    pendingBorrows: Array,\n    hasActiveBorrow: Boolean\n  },\n  data() {\n    return {\n      currentDate: new Date(),\n      dayNames: ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'],\n      showCarDialog: false,\n      showBookingDialog: false,\n      selectedCarRecord: null,\n      latestFuel: 50,\n      latestEasyPass: 500,\n      latestReturnLocation: null\n    };\n  },\n  computed: {\n    monthYear() {\n      return this.currentDate.toLocaleDateString('th-TH', {\n        year: 'numeric',\n        month: 'long'\n      });\n    },\n    calendarDates() {\n      const year = this.currentDate.getFullYear();\n      const month = this.currentDate.getMonth();\n      const firstDay = new Date(year, month, 1);\n      const startDate = new Date(firstDay);\n      startDate.setDate(startDate.getDate() - firstDay.getDay());\n      const dates = [];\n      const currentDate = new Date(startDate);\n      for (let i = 0; i < 42; i++) {\n        dates.push({\n          date: new Date(currentDate),\n          day: currentDate.getDate(),\n          isCurrentMonth: currentDate.getMonth() === month,\n          key: `${currentDate.getFullYear()}-${currentDate.getMonth()}-${currentDate.getDate()}`\n        });\n        currentDate.setDate(currentDate.getDate() + 1);\n      }\n      return dates;\n    }\n  },\n  mounted() {\n    this.fetchLatestFuel();\n  },\n  methods: {\n    formatColleagues(colleagues) {\n      if (!colleagues?.length) return '-';\n      return colleagues.map(c => typeof c === 'object' ? c.name || c.value : c).join(', ');\n    },\n    fuelSegments(level) {\n      const n = level || 0;\n      if (n >= 80) return 5;\n      if (n >= 60) return 4;\n      if (n >= 40) return 3;\n      if (n >= 20) return 2;\n      if (n > 0) return 1;\n      return 0;\n    },\n    fuelColorClass(level) {\n      const n = level || 0;\n      if (n >= 60) return 'seg-high';\n      if (n >= 30) return 'seg-mid';\n      return 'seg-low';\n    },\n    previousMonth() {\n      this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() - 1, 1);\n    },\n    nextMonth() {\n      this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() + 1, 1);\n    },\n    selectDate(date) {\n      if (this.isActiveUsage(date)) {\n        this.showCarDetails(date);\n      } else if (this.hasBookingOnDate(date)) {\n        this.showBookingDetails(date);\n      } else if (!this.isPastDate(date) && !this.hasBookingOnDate(date)) {\n        this.$emit('select-date', date);\n      }\n    },\n    async showCarDetails(date) {\n      const today = new Date();\n      today.setHours(0, 0, 0, 0);\n      const checkDate = new Date(date);\n      checkDate.setHours(0, 0, 0, 0);\n      if (checkDate.getTime() !== today.getTime()) return;\n      const activeBooking = this.records.find(r => r.status === 'active');\n      if (activeBooking) {\n        this.selectedCarRecord = activeBooking;\n        await this.fetchLatestFuel();\n        this.showCarDialog = true;\n      }\n    },\n    async showBookingDetails(date) {\n      const dateStr = date.toDateString();\n      const borrowRecord = this.records.find(r => (r.status === 'pending' || r.status === 'active') && new Date(r.selected_date).toDateString() === dateStr);\n      if (borrowRecord) {\n        this.selectedCarRecord = borrowRecord;\n        await this.fetchLatestFuel();\n        this.showBookingDialog = true;\n      }\n    },\n    async fetchLatestFuel() {\n      try {\n        const response = await this.$http.get('/api/car-booking/latest-fuel');\n        this.latestFuel = response.data.fuel_level || 50;\n        this.latestEasyPass = response.data.easy_pass_balance || 500;\n        this.latestReturnLocation = response.data.return_location || null;\n      } catch {\n        this.latestFuel = 50;\n        this.latestEasyPass = 500;\n        this.latestReturnLocation = null;\n      }\n    },\n    formatMoney(val) {\n      if (val == null) return '-';\n      return Number(val).toLocaleString('th-TH');\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleDateString('th-TH');\n    },\n    isPastDate(date) {\n      const today = new Date();\n      today.setHours(0, 0, 0, 0);\n      const checkDate = new Date(date);\n      checkDate.setHours(0, 0, 0, 0);\n      return checkDate < today;\n    },\n    hasBookingOnDate(date) {\n      const dateStr = date.toDateString();\n      return this.records.some(r => (r.status === 'pending' || r.status === 'active') && new Date(r.selected_date).toDateString() === dateStr);\n    },\n    isActiveUsage(date) {\n      // Find active booking\n      const activeBooking = this.records.find(r => r.status === 'active');\n      if (!activeBooking) return false;\n      const borrowDate = new Date(activeBooking.selected_date);\n      const today = new Date();\n\n      // If there's a return_date, use it as end date\n      let endDate;\n      if (activeBooking.return_date) {\n        endDate = new Date(activeBooking.return_date);\n      } else {\n        // If no return date, only show up to today (no future dates)\n        endDate = today;\n      }\n\n      // Show active status from borrow date to end date (but not beyond today)\n      return date >= borrowDate && date <= endDate && date <= today;\n    },\n    isToday(date) {\n      const today = new Date();\n      return date.toDateString() === today.toDateString();\n    }\n  }\n};","map":{"version":3,"names":["EasyPassCard","name","components","props","records","Array","availableBorrows","pendingBorrows","hasActiveBorrow","Boolean","data","currentDate","Date","dayNames","showCarDialog","showBookingDialog","selectedCarRecord","latestFuel","latestEasyPass","latestReturnLocation","computed","monthYear","toLocaleDateString","year","month","calendarDates","getFullYear","getMonth","firstDay","startDate","setDate","getDate","getDay","dates","i","push","date","day","isCurrentMonth","key","mounted","fetchLatestFuel","methods","formatColleagues","colleagues","length","map","c","value","join","fuelSegments","level","n","fuelColorClass","previousMonth","nextMonth","selectDate","isActiveUsage","showCarDetails","hasBookingOnDate","showBookingDetails","isPastDate","$emit","today","setHours","checkDate","getTime","activeBooking","find","r","status","dateStr","toDateString","borrowRecord","selected_date","response","$http","get","fuel_level","easy_pass_balance","return_location","formatMoney","val","Number","toLocaleString","formatDate","dateString","some","borrowDate","endDate","return_date","isToday"],"sources":["D:\\frontend_cem\\src\\views\\car_booking\\Calendar.vue"],"sourcesContent":["<template>\r\n  <Card>\r\n    <template #content>\r\n      <div class=\"calendar-header\">\r\n        <button @click=\"previousMonth\" class=\"nav-btn\">\r\n          <i class=\"pi pi-chevron-left\"></i>\r\n        </button>\r\n        <div class=\"month-title-container\">\r\n          <h2 class=\"month-title\">{{ monthYear }}</h2>\r\n          <div class=\"calendar-subtitle\">ปฏิทินการใช้รถ</div>\r\n        </div>\r\n        <button @click=\"nextMonth\" class=\"nav-btn\">\r\n          <i class=\"pi pi-chevron-right\"></i>\r\n        </button>\r\n      </div>\r\n      <!-- Car Status Bar -->\r\n      <div class=\"car-status-bar\">\r\n        <div class=\"status-item\">\r\n          <i class=\"pi pi-bolt\" style=\"color: #f59e0b;\"></i>\r\n          <span class=\"status-label\">ระดับน้ำมัน</span>\r\n          <div class=\"status-fuel\">\r\n            <div class=\"fuel-segs-bar\">\r\n              <div v-for=\"seg in 5\" :key=\"seg\" class=\"fuel-seg-bar\"\r\n                :class=\"seg <= fuelSegments(latestFuel) ? fuelColorClass(latestFuel) : 'seg-empty'\"></div>\r\n            </div>\r\n            <span class=\"status-value\">{{ latestFuel }}%</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"status-divider\"></div>\r\n        <div class=\"status-item\">\r\n          <i class=\"pi pi-wallet\" style=\"color: #8b5cf6;\"></i>\r\n          <span class=\"status-label\">EasyPass</span>\r\n          <span class=\"status-value easypass-val\">฿{{ formatMoney(latestEasyPass) }}</span>\r\n        </div>\r\n        <div class=\"status-divider\"></div>\r\n        <div class=\"status-item\">\r\n          <i class=\"pi pi-map-marker\" style=\"color: #22c55e;\"></i>\r\n          <span class=\"status-label\">สถานที่คืนรถ</span>\r\n          <span class=\"status-value\">{{ latestReturnLocation || 'ไม่ระบุ' }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"calendar-container\">\r\n        <div class=\"calendar\">\r\n          <div class=\"day-header\" v-for=\"day in dayNames\" :key=\"day\">{{ day }}</div>\r\n          <div v-for=\"date in calendarDates\" :key=\"date.key\" :class=\"['calendar-day', {\r\n            'other-month': !date.isCurrentMonth,\r\n            'has-booking': hasBookingOnDate(date.date),\r\n            'active-usage': isActiveUsage(date.date),\r\n            'today': isToday(date.date),\r\n            'past-date': isPastDate(date.date)\r\n          }]\" @click=\"date.isCurrentMonth && selectDate(date.date)\">\r\n            {{ date.day }}\r\n            <div v-if=\"hasBookingOnDate(date.date) && !isActiveUsage(date.date)\" class=\"booking-indicator\">\r\n              <span class=\"booking-emoji\">📅</span>\r\n            </div>\r\n            <div v-if=\"hasBookingOnDate(date.date) && !isActiveUsage(date.date)\" class=\"booking-text-center\">\r\n              <div class=\"booking-text\">จองเเล้ว</div>\r\n            </div>\r\n\r\n\r\n\r\n            <div v-if=\"isActiveUsage(date.date)\" class=\"car-indicator\">\r\n\r\n              <div>\r\n\r\n                <span class=\"car-emoji\">🚗</span>\r\n              </div>\r\n              <div>\r\n                <p>กําลังใช้งาน</p>\r\n              </div>\r\n\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Car Details Dialog -->\r\n      <Dialog v-model:visible=\"showCarDialog\" modal header=\"🚗 รายละเอียดการใช้รถ\" :style=\"{ width: '90vw', maxWidth: '500px' }\"\r\n        :draggable=\"false\" :closable=\"false\">\r\n        <div v-if=\"selectedCarRecord\" class=\"car-details\">\r\n          <div class=\"car-header\">\r\n            <div class=\"car-plate-display\">\r\n              <i class=\"pi pi-car\"></i>\r\n              <span>FXAG-2032</span>\r\n            </div>\r\n            <div class=\"status-badge\">\r\n              <i class=\"pi pi-circle-fill\"></i>\r\n              กำลังใช้งาน\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"details-grid\">\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-user\"></i>\r\n                ผู้ใช้งาน\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.user_name || selectedCarRecord.username || selectedCarRecord.name || 'ไม่ระบุ' }}{{ selectedCarRecord.nickname ? ` (${selectedCarRecord.nickname})` : '' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                วันที่ใช้งาน\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ formatDate(selectedCarRecord.selected_date) }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-clock\"></i>\r\n                เวลา\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.time || 'ไม่ระบุ' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-briefcase\"></i>\r\n                โครงการ\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.project || 'ไม่ระบุ' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div v-if=\"selectedCarRecord.colleagues?.length > 0\" class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-users\"></i>\r\n                ผู้ร่วมเดินทาง\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ formatColleagues(selectedCarRecord.colleagues) }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row fuel-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-bolt\" style=\"color: #f59e0b;\"></i>\r\n                ระดับน้ำมัน\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                <div class=\"fuel-segments\">\r\n                  <div v-for=\"seg in 5\" :key=\"seg\" class=\"fuel-seg\" :class=\"seg <= fuelSegments(latestFuel) ? fuelColorClass(latestFuel) : 'seg-empty'\"></div>\r\n                </div>\r\n                <span class=\"fuel-text\">{{ latestFuel }}%</span>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\" style=\"margin-top: 0.5rem;\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-wallet\" style=\"color: #8b5cf6;\"></i>\r\n                Easy Pass\r\n              </div>\r\n            </div>\r\n            <EasyPassCard :modelValue=\"latestEasyPass\" :maxAmount=\"3000\" :disabled=\"true\" />\r\n          </div>\r\n        </div>\r\n\r\n        <template #footer>\r\n          <div class=\"dialog-footer\">\r\n            <Button label=\"ปิด\" icon=\"pi pi-times\" @click=\"showCarDialog = false\" class=\"p-button-secondary\" />\r\n          </div>\r\n        </template>\r\n      </Dialog>\r\n\r\n      <!-- Booking Details Dialog -->\r\n      <Dialog v-model:visible=\"showBookingDialog\" modal header=\"📅 รายละเอียดการจองรถ\" :style=\"{ width: '90vw', maxWidth: '500px' }\"\r\n        :draggable=\"false\" :closable=\"false\">\r\n        <div v-if=\"selectedCarRecord\" class=\"car-details\">\r\n          <div class=\"booking-header\">\r\n            <div class=\"car-plate-display\">\r\n              <i class=\"pi pi-calendar\"></i>\r\n              <span>FXAG-2032</span>\r\n            </div>\r\n            <div class=\"status-badge booking-status\">\r\n              <i class=\"pi pi-clock\"></i>\r\n              จองแล้ว\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"details-grid\">\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-user\"></i>\r\n                ผู้จอง\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.user_name || selectedCarRecord.username || selectedCarRecord.name || 'ไม่ระบุ' }}{{ selectedCarRecord.nickname ? ` (${selectedCarRecord.nickname})` : '' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-calendar\"></i>\r\n                วันที่จอง\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ formatDate(selectedCarRecord.selected_date) }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-clock\"></i>\r\n                เวลา\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.time || 'ไม่ระบุ' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-briefcase\"></i>\r\n                โครงการ\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ selectedCarRecord.project || 'ไม่ระบุ' }}\r\n              </div>\r\n            </div>\r\n\r\n            <div v-if=\"selectedCarRecord.colleagues?.length > 0\" class=\"detail-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-users\"></i>\r\n                ผู้ร่วมเดินทาง\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                {{ formatColleagues(selectedCarRecord.colleagues) }}\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row fuel-row\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-bolt\" style=\"color: #f59e0b;\"></i>\r\n                ระดับน้ำมัน\r\n              </div>\r\n              <div class=\"detail-value\">\r\n                <div class=\"fuel-segments\">\r\n                  <div v-for=\"seg in 5\" :key=\"seg\" class=\"fuel-seg\" :class=\"seg <= fuelSegments(latestFuel) ? fuelColorClass(latestFuel) : 'seg-empty'\"></div>\r\n                </div>\r\n                <span class=\"fuel-text\">{{ latestFuel }}%</span>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"detail-row\" style=\"margin-top: 0.5rem;\">\r\n              <div class=\"detail-label\">\r\n                <i class=\"pi pi-wallet\" style=\"color: #8b5cf6;\"></i>\r\n                Easy Pass\r\n              </div>\r\n            </div>\r\n            <EasyPassCard :modelValue=\"latestEasyPass\" :maxAmount=\"3000\" :disabled=\"true\" />\r\n          </div>\r\n        </div>\r\n\r\n        <template #footer>\r\n          <div class=\"dialog-footer\">\r\n            <Button label=\"ปิด\" icon=\"pi pi-times\" @click=\"showBookingDialog = false\" class=\"p-button-secondary\" />\r\n          </div>\r\n        </template>\r\n      </Dialog>\r\n    </template>\r\n  </Card>\r\n</template>\r\n\r\n<script>\r\nimport EasyPassCard from '@/components/EasyPassCard.vue'\r\n\r\nexport default {\r\n  name: 'CarCalendar',\r\n  components: { EasyPassCard },\r\n  props: {\r\n    records: Array,\r\n    availableBorrows: Array,\r\n    pendingBorrows: Array,\r\n    hasActiveBorrow: Boolean\r\n  },\r\n  data() {\r\n    return {\r\n      currentDate: new Date(),\r\n      dayNames: ['อา', 'จ', 'อ', 'พ', 'พฤ', 'ศ', 'ส'],\r\n      showCarDialog: false,\r\n      showBookingDialog: false,\r\n      selectedCarRecord: null,\r\n      latestFuel: 50,\r\n      latestEasyPass: 500,\r\n      latestReturnLocation: null\r\n    }\r\n  },\r\n  computed: {\r\n    monthYear() {\r\n      return this.currentDate.toLocaleDateString('th-TH', {\r\n        year: 'numeric',\r\n        month: 'long'\r\n      })\r\n    },\r\n    calendarDates() {\r\n      const year = this.currentDate.getFullYear()\r\n      const month = this.currentDate.getMonth()\r\n\r\n      const firstDay = new Date(year, month, 1)\r\n      const startDate = new Date(firstDay)\r\n      startDate.setDate(startDate.getDate() - firstDay.getDay())\r\n\r\n      const dates = []\r\n      const currentDate = new Date(startDate)\r\n\r\n      for (let i = 0; i < 42; i++) {\r\n        dates.push({\r\n          date: new Date(currentDate),\r\n          day: currentDate.getDate(),\r\n          isCurrentMonth: currentDate.getMonth() === month,\r\n          key: `${currentDate.getFullYear()}-${currentDate.getMonth()}-${currentDate.getDate()}`\r\n        })\r\n        currentDate.setDate(currentDate.getDate() + 1)\r\n      }\r\n\r\n      return dates\r\n    }\r\n  },\r\n  mounted() {\r\n    this.fetchLatestFuel()\r\n  },\r\n  methods: {\r\n    formatColleagues(colleagues) {\r\n      if (!colleagues?.length) return '-'\r\n      return colleagues.map(c => typeof c === 'object' ? (c.name || c.value) : c).join(', ')\r\n    },\r\n    fuelSegments(level) {\r\n      const n = level || 0\r\n      if (n >= 80) return 5\r\n      if (n >= 60) return 4\r\n      if (n >= 40) return 3\r\n      if (n >= 20) return 2\r\n      if (n > 0) return 1\r\n      return 0\r\n    },\r\n    fuelColorClass(level) {\r\n      const n = level || 0\r\n      if (n >= 60) return 'seg-high'\r\n      if (n >= 30) return 'seg-mid'\r\n      return 'seg-low'\r\n    },\r\n    previousMonth() {\r\n      this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() - 1, 1)\r\n    },\r\n    nextMonth() {\r\n      this.currentDate = new Date(this.currentDate.getFullYear(), this.currentDate.getMonth() + 1, 1)\r\n    },\r\n    selectDate(date) {\r\n      if (this.isActiveUsage(date)) {\r\n        this.showCarDetails(date)\r\n      } else if (this.hasBookingOnDate(date)) {\r\n        this.showBookingDetails(date)\r\n      } else if (!this.isPastDate(date) && !this.hasBookingOnDate(date)) {\r\n        this.$emit('select-date', date)\r\n      }\r\n    },\r\n    async showCarDetails(date) {\r\n      const today = new Date()\r\n      today.setHours(0, 0, 0, 0)\r\n\r\n      const checkDate = new Date(date)\r\n      checkDate.setHours(0, 0, 0, 0)\r\n\r\n      if (checkDate.getTime() !== today.getTime()) return\r\n\r\n      const activeBooking = this.records.find(r => r.status === 'active')\r\n      if (activeBooking) {\r\n        this.selectedCarRecord = activeBooking\r\n        await this.fetchLatestFuel()\r\n        this.showCarDialog = true\r\n      }\r\n    },\r\n    async showBookingDetails(date) {\r\n      const dateStr = date.toDateString()\r\n      const borrowRecord = this.records.find(r =>\r\n        (r.status === 'pending' || r.status === 'active') &&\r\n        new Date(r.selected_date).toDateString() === dateStr\r\n      )\r\n\r\n      if (borrowRecord) {\r\n        this.selectedCarRecord = borrowRecord\r\n        await this.fetchLatestFuel()\r\n        this.showBookingDialog = true\r\n      }\r\n    },\r\n    async fetchLatestFuel() {\r\n      try {\r\n        const response = await this.$http.get('/api/car-booking/latest-fuel')\r\n        this.latestFuel = response.data.fuel_level || 50\r\n        this.latestEasyPass = response.data.easy_pass_balance || 500\r\n        this.latestReturnLocation = response.data.return_location || null\r\n      } catch {\r\n        this.latestFuel = 50\r\n        this.latestEasyPass = 500\r\n        this.latestReturnLocation = null\r\n      }\r\n    },\r\n    formatMoney(val) {\r\n      if (val == null) return '-'\r\n      return Number(val).toLocaleString('th-TH')\r\n    },\r\n    formatDate(dateString) {\r\n      const date = new Date(dateString)\r\n      return date.toLocaleDateString('th-TH')\r\n    },\r\n    isPastDate(date) {\r\n      const today = new Date()\r\n      today.setHours(0, 0, 0, 0)\r\n      const checkDate = new Date(date)\r\n      checkDate.setHours(0, 0, 0, 0)\r\n      return checkDate < today\r\n    },\r\n    hasBookingOnDate(date) {\r\n      const dateStr = date.toDateString()\r\n\r\n      return this.records.some(r =>\r\n        (r.status === 'pending' || r.status === 'active') &&\r\n        new Date(r.selected_date).toDateString() === dateStr\r\n      )\r\n    },\r\n    isActiveUsage(date) {\r\n      // Find active booking\r\n      const activeBooking = this.records.find(r => r.status === 'active')\r\n      if (!activeBooking) return false\r\n\r\n      const borrowDate = new Date(activeBooking.selected_date)\r\n      const today = new Date()\r\n\r\n      // If there's a return_date, use it as end date\r\n      let endDate\r\n      if (activeBooking.return_date) {\r\n        endDate = new Date(activeBooking.return_date)\r\n      } else {\r\n        // If no return date, only show up to today (no future dates)\r\n        endDate = today\r\n      }\r\n\r\n      // Show active status from borrow date to end date (but not beyond today)\r\n      ret