{"ast":null,"code":"import { ref, onMounted, onUnmounted, computed } from \"vue\";\nimport axios from \"axios\";\nimport ConfirmDialog from \"primevue/confirmdialog\";\nimport { usePermissions } from \"@/composables/usePermissions\";\nimport AnnouncementBanner from \"./AnnouncementBanner.vue\";\nexport default {\n  __name: 'LayoutView',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const {\n      loadPermissions,\n      hasAccess\n    } = usePermissions();\n    const position = ref(\"center\");\n    const visible = ref(false);\n    const sessionDialog = ref(false);\n    const sidebarVisible = ref(true);\n    const isMobile = ref(window.innerWidth <= 768);\n    const announcementBanner = ref(null);\n    const bannerVisible = ref(true);\n    const openPosition = pos => {\n      position.value = pos;\n      visible.value = true;\n    };\n    const toggleSidebar = () => {\n      sidebarVisible.value = !sidebarVisible.value;\n    };\n    const toggleBanner = () => {\n      // เช็คว่า bannerVisible เปลี่ยนค่าแล้ว (จาก v-model)\n      if (announcementBanner.value) {\n        if (bannerVisible.value) {\n          announcementBanner.value.showBanner();\n        } else {\n          announcementBanner.value.closeBanner();\n        }\n      }\n    };\n    const closeSidebarOnMobile = () => {\n      if (window.innerWidth <= 768) {\n        sidebarVisible.value = false;\n      }\n    };\n    const updateIsMobile = () => {\n      isMobile.value = window.innerWidth <= 768;\n    };\n    const mainContentClass = computed(() => {\n      return sidebarVisible.value ? 'col-9 col-sm-9 col-md-10 col-lg-10 col-xl-10' : 'col-12';\n    });\n    var soc_user_id = ref();\n    var soc_user = ref();\n    var soc_user_firstLetter = ref();\n    var soc_role = ref();\n    var soc_firstname = ref();\n    var soc_lastname = ref();\n    var users = ref();\n    var currentTime = ref(new Date());\n    const currentDateTime = computed(() => {\n      return currentTime.value.toLocaleString('th-TH', {\n        year: 'numeric',\n        month: 'long',\n        day: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit',\n        second: '2-digit'\n      });\n    });\n\n    // eslint-disable-next-line\n    function fetchData() {\n      axios.get('/user', {}).then(user_response => {\n        users.value = user_response.data.data;\n      });\n    }\n\n    // eslint-disable-next-line\n    const resetTimer = () => {\n      timeout.value = 300; // รีเซ็ตเวลาเป็น 5 นาที\n    };\n    onMounted(() => {\n      loadPermissions();\n      startCountdown();\n      window.addEventListener(\"mousemove\", resetTimer);\n      window.addEventListener(\"keydown\", resetTimer);\n      window.addEventListener(\"resize\", updateIsMobile);\n      soc_user_id.value = localStorage.getItem(\"soc_user_id\");\n      soc_user.value = localStorage.getItem(\"soc_user\");\n      soc_role.value = localStorage.getItem(\"soc_role\");\n      soc_firstname.value = localStorage.getItem(\"soc_firstname\") || \"No data\";\n      soc_lastname.value = localStorage.getItem(\"soc_lastname\") || \"No data\";\n      if (soc_user.value != null) {\n        soc_user_firstLetter.value = soc_user.value.charAt(0).toUpperCase();\n      }\n\n      // Update time every second\n      setInterval(() => {\n        currentTime.value = new Date();\n      }, 1000);\n\n      // Check if banner is closed and update layout\n      checkBannerStatus();\n\n      // Listen for banner visibility changes\n      const checkBannerInterval = setInterval(() => {\n        checkBannerStatus();\n      }, 1000);\n\n      // Store interval ID for cleanup\n      window.bannerCheckInterval = checkBannerInterval;\n    });\n    const checkBannerStatus = () => {\n      const wasClosed = localStorage.getItem('announcementBannerClosed');\n      // ถ้าเคยปิดไว้ ให้ตั้งค่า bannerVisible เป็น false\n      bannerVisible.value = wasClosed !== 'true';\n    };\n    onUnmounted(() => {\n      clearInterval(countdownTimer);\n      window.removeEventListener(\"mousemove\", resetTimer);\n      window.removeEventListener(\"keydown\", resetTimer);\n      window.removeEventListener(\"resize\", updateIsMobile);\n\n      // Clean up banner check interval\n      if (window.bannerCheckInterval) {\n        clearInterval(window.bannerCheckInterval);\n      }\n    });\n    const showSessionDialog = () => {\n      sessionDialog.value = true;\n    };\n    const timeout = ref(300); // 5 นาที (300 วินาที)\n    let countdownTimer = null; // ✅ กำหนดตัวแปรให้อยู่ภายนอก\n\n    const reloadTab = () => {\n      // Don't clear localStorage immediately, let user choose\n      showSessionDialog.value = true;\n    };\n    const locationLogout = () => {\n      localStorage.clear();\n      sessionStorage.clear();\n      window.location.href = \"/login\";\n    };\n    const logout = async () => {\n      try {\n        // เรียก API logout เพื่อ clear cookie\n        await axios.post('/api/auth/logout');\n      } catch {\n        // ignore\n      } finally {\n        // Clear localStorage และ sessionStorage\n        localStorage.clear();\n        sessionStorage.clear();\n\n        // Clear all cookies\n        document.cookie.split(\";\").forEach(c => {\n          document.cookie = c.replace(/^ +/, \"\").replace(/=.*/, \"=;expires=\" + new Date().toUTCString() + \";path=/\");\n        });\n\n        // Redirect\n        window.location.href = \"/login\";\n      }\n    };\n    const startCountdown = () => {\n      countdownTimer = setInterval(() => {\n        timeout.value--;\n        if (timeout.value <= 0) {\n          clearInterval(countdownTimer);\n          reloadTab();\n        }\n      }, 2000);\n    };\n    const __returned__ = {\n      loadPermissions,\n      hasAccess,\n      position,\n      visible,\n      sessionDialog,\n      sidebarVisible,\n      isMobile,\n      announcementBanner,\n      bannerVisible,\n      openPosition,\n      toggleSidebar,\n      toggleBanner,\n      closeSidebarOnMobile,\n      updateIsMobile,\n      mainContentClass,\n      get soc_user_id() {\n        return soc_user_id;\n      },\n      set soc_user_id(v) {\n        soc_user_id = v;\n      },\n      get soc_user() {\n        return soc_user;\n      },\n      set soc_user(v) {\n        soc_user = v;\n      },\n      get soc_user_firstLetter() {\n        return soc_user_firstLetter;\n      },\n      set soc_user_firstLetter(v) {\n        soc_user_firstLetter = v;\n      },\n      get soc_role() {\n        return soc_role;\n      },\n      set soc_role(v) {\n        soc_role = v;\n      },\n      get soc_firstname() {\n        return soc_firstname;\n      },\n      set soc_firstname(v) {\n        soc_firstname = v;\n      },\n      get soc_lastname() {\n        return soc_lastname;\n      },\n      set soc_lastname(v) {\n        soc_lastname = v;\n      },\n      get users() {\n        return users;\n      },\n      set users(v) {\n        users = v;\n      },\n      get currentTime() {\n        return currentTime;\n      },\n      set currentTime(v) {\n        currentTime = v;\n      },\n      currentDateTime,\n      fetchData,\n      resetTimer,\n      checkBannerStatus,\n      showSessionDialog,\n      timeout,\n      get countdownTimer() {\n        return countdownTimer;\n      },\n      set countdownTimer(v) {\n        countdownTimer = v;\n      },\n      reloadTab,\n      locationLogout,\n      logout,\n      startCountdown,\n      ref,\n      onMounted,\n      onUnmounted,\n      computed,\n      get axios() {\n        return axios;\n      },\n      get ConfirmDialog() {\n        return ConfirmDialog;\n      },\n      get usePermissions() {\n        return usePermissions;\n      },\n      AnnouncementBanner\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","axios","ConfirmDialog","usePermissions","AnnouncementBanner","loadPermissions","hasAccess","position","visible","sessionDialog","sidebarVisible","isMobile","window","innerWidth","announcementBanner","bannerVisible","openPosition","pos","value","toggleSidebar","toggleBanner","showBanner","closeBanner","closeSidebarOnMobile","updateIsMobile","mainContentClass","soc_user_id","soc_user","soc_user_firstLetter","soc_role","soc_firstname","soc_lastname","users","currentTime","Date","currentDateTime","toLocaleString","year","month","day","hour","minute","second","fetchData","get","then","user_response","data","resetTimer","timeout","startCountdown","addEventListener","localStorage","getItem","charAt","toUpperCase","setInterval","checkBannerStatus","checkBannerInterval","bannerCheckInterval","wasClosed","clearInterval","countdownTimer","removeEventListener","showSessionDialog","reloadTab","locationLogout","clear","sessionStorage","location","href","logout","post","document","cookie","split","forEach","c","replace","toUTCString"],"sources":["D:/frontend_cem/src/components/LayoutView.vue"],"sourcesContent":["<template>\r\n  <!-- Announcement Banner -->\r\n  <AnnouncementBanner \r\n    ref=\"announcementBanner\"\r\n    title=\"ประกาศสำคัญ\"\r\n    message=\"ยินดีต้อนรับสู่ระบบ CEM กรุณาอ่านประกาศก่อนใช้งาน\"\r\n  />\r\n\r\n  <Toast />\r\n  <ConfirmDialog :draggable=\"false\"></ConfirmDialog>\r\n  <ConfirmPopup group=\"templating\">\r\n    <template #message=\"slotProps\">\r\n      <div class=\"flex flex-column align-items-center w-full gap-3 border-bottom-1 surface-border p-3 mb-3 pb-0\">\r\n        <i :class=\"slotProps.message.icon\" class=\"text-6xl text-primary-500\"></i>\r\n        <p>{{ slotProps.message.message }}</p>\r\n      </div>\r\n    </template>\r\n  </ConfirmPopup>\r\n\r\n  <!-- Dialog Session หมดอายุ -->\r\n  <Dialog v-model:visible=\"sessionDialog\" header=\"Session หมดอายุ!\" modal :closable=\"false\" :closeOnEscape=\"false\">\r\n    <div class=\"flex align-items-center gap-2\">\r\n      <i class=\"pi pi-info-circle text-primary text-xl\" />\r\n      <span>session หมดอายุ! กรุณาทําการล็อกอินใหม่อีกครั้ง</span>\r\n    </div>\r\n    <template #footer>\r\n      <Button label=\"OK\" class=\"p-button-danger\" @click=\"locationLogout\" />\r\n    </template>\r\n  </Dialog>\r\n  <!-- Dialog Session หมดอายุ -->\r\n\r\n  <div class=\"flex flex-column card\" :class=\"{ 'sidebar-hidden': !sidebarVisible, 'banner-visible': bannerVisible }\" style=\"height: 100vh; width: 100%; overflow: hidden;\">\r\n    <div class=\"row\" style=\"height: 100%; overflow: hidden;\">\r\n      <!-- Toggle Button - แสดงด้านซ้ายเสมอ -->\r\n      <Button @click=\"toggleSidebar\" class=\"sidebar-toggle-btn\"\r\n        :icon=\"sidebarVisible ? 'pi pi-chevron-left' : 'pi pi-chevron-right'\" severity=\"secondary\" text\r\n        :v-tooltip=\"sidebarVisible ? 'ซ่อนเมนู' : 'แสดงเมนู'\" />\r\n\r\n      <Dialog v-model:visible=\"visible\" header=\"Setting\" \r\n        :style=\"{ width: isMobile ? '90vw' : '400px', maxWidth: '90vw', bottom: '20px' }\" \r\n        :position=\"position\" :modal=\"true\" :draggable=\"false\">\r\n        <div class=\"flex align-items-center gap-3 mb-3 mt-3\">\r\n          <router-link to=\"/profile\" @click=\"visible = false\" class=\"nav-link\">\r\n            <h5>\r\n              <i class=\"pi pi-megaphone px-2\" style=\"font-size: 1.5rem\"></i>Profile\r\n            </h5>\r\n          </router-link>\r\n        </div>\r\n        <div class=\"flex align-items-center gap-3 mb-3\">\r\n          <router-link to=\"/login\" @click=\"logout\" class=\"nav-link\">\r\n            <h5>\r\n              <i class=\"pi pi-sign-out px-2\" style=\"font-size: 1.2rem\"></i>Logout\r\n            </h5>\r\n          </router-link>\r\n        </div>\r\n        <div class=\"flex justify-content-end dialog-footer\">\r\n          <Button type=\"button\" label=\"Cancel\" severity=\"danger\" @click=\"visible = false\"></Button>\r\n        </div>\r\n      </Dialog>\r\n\r\n      <div v-show=\"sidebarVisible\" class=\"col-3 col-sm-3 col-md-2 col-lg-2 col-xl-2 bg-light p-0 sidebar-column\">\r\n        <div class=\"p-4 sidebar-container\" style=\"height: 100%; padding-top: 0px !important\">\r\n          <div class=\"logo-section\">\r\n            <img src=\"@/assets/images/NGENT.png\" alt=\"GENT Logo\" style=\"max-width: 150px; height: auto;\" />\r\n          </div>\r\n\r\n          <div class=\"datetime-section\">\r\n            <div class=\"datetime-display\">\r\n              <i class=\"pi pi-calendar\"></i>\r\n              <span>{{ currentDateTime }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <ul class=\"nav-menu\">\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/daily_work')\">\r\n              <router-link to=\"/daily_work\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-calendar px-2\" style=\"font-size: 1.5rem\"></i>ลงงานรายวัน\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/car_booking')\">\r\n              <router-link to=\"/car_booking\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-car px-2\" style=\"font-size: 1.5rem\"></i>เเจ้งใช้รถ\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/leave_work')\">\r\n              <router-link to=\"/leave_work\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-sign-out px-2\" style=\"font-size: 1.5rem\"></i>ลางาน\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/projects')\">\r\n              <router-link to=\"/projects\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-briefcase px-2\" style=\"font-size: 1.5rem\"></i>โครงการ\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/project-progress')\">\r\n              <router-link to=\"/project-progress\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-chart-line px-2\" style=\"font-size: 1.5rem\"></i>ขั้นตอนโครงการ\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n            <li class=\"nav-item ml-2 mt-2\" v-if=\"hasAccess('/management')\">\r\n              <router-link to=\"/management\" @click=\"closeSidebarOnMobile\" class=\"nav-link\" active-class=\"active\">\r\n                <h5 class=\"mt-2\">\r\n                  <i class=\"pi pi-cog px-2\" style=\"font-size: 1.5rem\"></i>จัดการระบบ\r\n                </h5>\r\n              </router-link>\r\n            </li>\r\n          </ul>\r\n          \r\n          <!-- Banner Toggle Button - iPhone Style -->\r\n          <div class=\"nav-item ml-2 mt-3\">\r\n            <div class=\"banner-toggle-container\">\r\n              <div class=\"banner-toggle-label\">\r\n                <span class=\"toggle-text\">Open/Close Text Chat</span>\r\n                <label class=\"ios-toggle-switch\">\r\n                  <input \r\n                    type=\"checkbox\" \r\n                    v-model=\"bannerVisible\" \r\n                    @change=\"toggleBanner\"\r\n                    class=\"toggle-input\"\r\n                  >\r\n                  <div class=\"toggle-slider\"></div>\r\n                  <div class=\"toggle-knob\"></div>\r\n                </label>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"nav-item ml-2\"\r\n            style=\"width: 100%; color: white; vertical-align: bottom; display: flex; justify-content: center;\">\r\n            <Button @click=\"openPosition('bottom')\" style=\"\r\n                width: 80%;\r\n                min-width: 8rem;\r\n                color: white;\r\n                background: linear-gradient(135deg, #4A90E2, #D73527);\r\n                border: none;\r\n                border-radius: 8px;\r\n                box-shadow: 0 2px 8px rgba(74, 144, 226, 0.3);\r\n                transition: all 0.3s ease;\r\n                display: flex;\r\n                align-items: center;\r\n                justify-content: center;\r\n                padding: 8px 16px;\r\n              \" class=\"setting-button\">\r\n              <h5 style=\"margin: 0; display: flex; align-items: center; justify-content: center;\">\r\n                <i class=\"pi pi-cog px-2\" style=\"font-size: 1.2rem\"></i>Setting\r\n              </h5>\r\n            </Button>\r\n            <!-- <router-link to=\"/login\" class=\"nav-link\"><h5><i class=\"pi pi-sign-out px-2\" style=\"font-size: 1.2rem;\"></i>Logout</h5></router-link> -->\r\n            <!-- <router-link to=\"/login\" class=\"btn btn-danger\" style=\"width: 100%;\">ออกจากระบบ</router-link> -->\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div :class=\"mainContentClass\" style=\"height: 100%; padding: 0; overflow: hidden;\">\r\n        <div class=\"pt-1 pb-3 container-fluid h-100 content-padding\">\r\n          <div class=\"main-content-wrapper\">\r\n            <ScrollPanel style=\"\r\n                width: 100%;\r\n                height: calc(100vh);\r\n                padding-right: 0;\r\n                padding-bottom: 0.5rem;\r\n              \">\r\n              <RouterView />\r\n            </ScrollPanel>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\n