ed')\n  if (wasClosed === 'true') {\n    isVisible.value = false\n  }\n\n  // ถ้าตั้งค่าให้ซ่อนอัตโนมัติ\n  if (props.autoHide) {\n    setTimeout(() => {\n      closeBanner()\n    }, props.hideDelay)\n  }\n})\n\n// เปิดให้ component อื่นเรียกใช้\ndefineExpose({\n  showBanner,\n  closeBanner\n})\n</script>\n\n<style scoped>\n.announcement-banner {\n  background: linear-gradient(135deg, rgba(74, 144, 226, 0.95) 0%, rgba(215, 53, 39, 0.95) 100%);\n  color: white;\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1100;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\n  backdrop-filter: blur(16px);\n  border-bottom: 2px solid rgba(255, 255, 255, 0.4);\n  animation: bannerGlow 3s ease-in-out infinite alternate;\n}\n\n@keyframes bannerGlow {\n  0% {\n    box-shadow: 0 8px 32px rgba(74, 144, 226, 0.4);\n    border-color: rgba(74, 144, 226, 0.5);\n  }\n  100% {\n    box-shadow: 0 8px 40px rgba(215, 53, 39, 0.5);\n    border-color: rgba(215, 53, 39, 0.6);\n  }\n}\n\n.banner-content {\n  display: flex;\n  align-items: center;\n  padding: 0;\n  gap: 0;\n  max-width: 100%;\n  height: 70px;\n  width: 100%;\n}\n\n.banner-text-container {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  position: relative;\n  width: 100%;\n}\n\n.banner-text-wrapper {\n  display: flex;\n  animation: scrollText 15s linear infinite;\n  width: max-content;\n}\n\n.banner-text {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n  padding-right: 8rem;\n}\n\n.banner-text.clone {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n}\n\n@keyframes scrollText {\n  0% {\n    transform: translateX(100%);\n  }\n  100% {\n    transform: translateX(-100%);\n  }\n}\n\n.text-icon {\n  font-size: 1.5rem;\n  animation: iconBounce 2s ease-in-out infinite;\n}\n\n@keyframes iconBounce {\n  0%, 100% {\n    transform: translateY(0px) scale(1);\n  }\n  50% {\n    transform: translateY(-3px) scale(1.2);\n  }\n}\n\n.banner-text h4 {\n  margin: 0;\n  font-size: 1.3rem;\n  font-weight: 700;\n  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);\n  letter-spacing: 0.8px;\n  color: white;\n}\n\n.banner-text p {\n  margin: 0;\n  font-size: 1.1rem;\n  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);\n  color: rgba(255, 255, 255, 0.95);\n}\n\n.separator {\n  font-size: 1.5rem;\n  font-weight: bold;\n  opacity: 0.8;\n}\n\n/* Animation */\n.banner-slide-enter-active,\n.banner-slide-leave-active {\n  transition: all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n.banner-slide-enter-from {\n  transform: translateY(-100%) rotateX(-90deg);\n  opacity: 0;\n}\n\n.banner-slide-leave-to {\n  transform: translateY(-100%) rotateX(90deg);\n  opacity: 0;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .banner-content {\n    padding: 0 1rem;\n  }\n  \n  .banner-text {\n    gap: 1.5rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 1.1rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.9rem;\n  }\n  \n  .text-icon {\n    font-size: 1.2rem;\n  }\n  \n  .separator {\n    font-size: 1.2rem;\n  }\n}\n\n@media (max-width: 480px) {\n  .banner-content {\n    padding: 0 0.75rem;\n  }\n  \n  .banner-text {\n    gap: 1rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 1rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.8rem;\n  }\n  \n  .text-icon {\n    font-size: 1rem;\n  }\n  \n  .separator {\n    font-size: 1rem;\n  }\n}\n</style>\n"],"mappings":";;;EAE0BA,KAAK,EAAC;;;EACrBA,KAAK,EAAC;AAAgB;;EACpBA,KAAK,EAAC;AAAuB;;EAC3BA,KAAK,EAAC;AAAqB;;EACzBA,KAAK,EAAC;AAAa;;EAMnBA,KAAK,EAAC;AAAmB;;uBAXxCC,YAAA,CAqBaC,WAAA;IArBDC,IAAI,EAAC;EAAc;sBAC7B,MAmBM,CAnBKC,MAAA,CAAAC,SAAS,I,cAApBC,mBAAA,CAmBM,OAnBNC,UAmBM,GAlBJC,mBAAA,CAiBM,OAjBNC,UAiBM,GAhBJD,mBAAA,CAeM,OAfNE,UAeM,GAdJF,mBAAA,CAaM,OAbNG,UAaM,GAZJH,mBAAA,CAKM,OALNI,UAKM,G,0BAJJJ,mBAAA,CAAiC;MAA3BR,KAAK,EAAC;IAAW,GAAC,IAAE,qBAC1BQ,mBAAA,CAAoB,YAAAK,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kB,0BACZP,mBAAA,CAAgC;MAA1BR,KAAK,EAAC;IAAW,GAAC,GAAC,qBACzBQ,mBAAA,CAAoB,WAAAK,gBAAA,CAAdC,MAAA,CAAAE,OAAO,iB,GAEfR,mBAAA