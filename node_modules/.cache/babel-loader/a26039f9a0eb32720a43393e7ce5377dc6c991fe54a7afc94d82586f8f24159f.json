{"ast":null,"code":"import { ref, onMounted } from 'vue';\nexport default {\n  __name: 'AnnouncementBanner',\n  props: {\n    autoHide: {\n      type: Boolean,\n      default: false\n    },\n    hideDelay: {\n      type: Number,\n      default: 5000\n    }\n  },\n  setup(__props, {\n    expose: __expose\n  }) {\n    /* global defineProps, defineExpose */\n\n    const props = __props;\n    const isVisible = ref(true);\n    const isPaused = ref(false);\n    const announcementItems = ref([{\n      icon: '📢',\n      text: 'ยินดีต้อนรับสู่ระบบ CEM',\n      tag: 'h4',\n      type: ''\n    }, {\n      icon: '🚀',\n      text: 'ระบบจัดการงานที่ทันสมัย',\n      tag: 'p',\n      type: ''\n    }, {\n      icon: '✨',\n      text: 'ใหม่! ฟีเจอร์การแชทแบบเรียลไทม์',\n      tag: 'span',\n      type: 'highlight'\n    }, {\n      icon: '📅',\n      text: 'อัปเดตล่าสุด: 20 กุมภาพันธ์ 2026',\n      tag: 'span',\n      type: 'info'\n    }]);\n    const closeBanner = () => {\n      isVisible.value = false;\n      localStorage.setItem('announcementBannerClosed', 'true');\n    };\n    const showBanner = () => {\n      isVisible.value = true;\n      localStorage.removeItem('announcementBannerClosed');\n    };\n    onMounted(() => {\n      if (localStorage.getItem('announcementBannerClosed') === 'true') {\n        isVisible.value = false;\n      }\n      if (props.autoHide) {\n        setTimeout(closeBanner, props.hideDelay);\n      }\n    });\n    __expose({\n      showBanner,\n      closeBanner\n    });\n    const __returned__ = {\n      props,\n      isVisible,\n      isPaused,\n      announcementItems,\n      closeBanner,\n      showBanner,\n      ref,\n      onMounted\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","props","__props","isVisible","isPaused","announcementItems","icon","text","tag","type","closeBanner","value","localStorage","setItem","showBanner","removeItem","getItem","autoHide","setTimeout","hideDelay","__expose"],"sources":["D:/frontend_cem/src/components/AnnouncementBanner.vue"],"sourcesContent":["<template>\n  <transition name=\"banner-slide\">\n    <div v-if=\"isVisible\" class=\"announcement-banner\" @mouseenter=\"isPaused = true\" @mouseleave=\"isPaused = false\">\n      <div class=\"banner-content\">\n        <div class=\"marquee-track\" :class=\"{ 'paused': isPaused }\">\n          \n          <div class=\"items-group\">\n            <div \n              v-for=\"(item, index) in announcementItems\" \n              :key=\"'first-' + index\"\n              class=\"floating-item\"\n            >\n              <span class=\"text-icon\">{{ item.icon }}</span>\n              <component :is=\"item.tag\" :class=\"item.type\">{{ item.text }}</component>\n            </div>\n          </div>\n\n          <div class=\"items-group\" aria-hidden=\"true\">\n            <div \n              v-for=\"(item, index) in announcementItems\" \n              :key=\"'second-' + index\"\n              class=\"floating-item\"\n            >\n              <span class=\"text-icon\">{{ item.icon }}</span>\n              <component :is=\"item.tag\" :class=\"item.type\">{{ item.text }}</component>\n            </div>\n          </div>\n\n        </div>\n      </div>\n      \n      <button class=\"close-banner\" @click=\"closeBanner\" title=\"ปิดประกาศ\">×</button>\n    </div>\n  </transition>\n</template>\n\n<script setup>\n/* global defineProps, defineExpose */\n\nimport { ref, onMounted } from 'vue'\n\nconst props = defineProps({\n  autoHide: { type: Boolean, default: false },\n  hideDelay: { type: Number, default: 5000 }\n})\n\nconst isVisible = ref(true)\nconst isPaused = ref(false)\n\nconst announcementItems = ref([\n  { icon: '📢', text: 'ยินดีต้อนรับสู่ระบบ CEM', tag: 'h4', type: '' },\n  { icon: '🚀', text: 'ระบบจัดการงานที่ทันสมัย', tag: 'p', type: '' },\n  { icon: '✨', text: 'ใหม่! ฟีเจอร์การแชทแบบเรียลไทม์', tag: 'span', type: 'highlight' },\n  { icon: '📅', text: 'อัปเดตล่าสุด: 20 กุมภาพันธ์ 2026', tag: 'span', type: 'info' }\n])\n\nconst closeBanner = () => {\n  isVisible.value = false\n  localStorage.setItem('announcementBannerClosed', 'true')\n}\n\nconst showBanner = () => {\n  isVisible.value = true\n  localStorage.removeItem('announcementBannerClosed')\n}\n\nonMounted(() => {\n  if (localStorage.getItem('announcementBannerClosed') === 'true') {\n    isVisible.value = false\n  }\n  if (props.autoHide) {\n    setTimeout(closeBanner, props.hideDelay)\n  }\n})\n\ndefineExpose({ showBanner, closeBanner })\n</script>\n\n<style scoped>\n.announcement-banner {\n  background: linear-gradient(135deg, rgba(44, 62, 80, 0.95) 0%, rgba(0, 0, 0, 0.95) 100%);\n  color: white;\n  position: fixed;\n  top: 0; left: 0; right: 0;\n  z-index: 1100;\n  height: 60px; /* ปรับขนาดให้กระชับขึ้น */\n  display: flex;\n  align-items: center;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.3);\n  backdrop-filter: blur(10px);\n  overflow: hidden;\n}\n\n.banner-content {\n  flex: 1;\n  position: relative;\n  display: flex;\n  align-items: center;\n  overflow: hidden;\n}\n\n.marquee-track {\n  display: flex;\n  align-items: center;\n  width: max-content;\n  animation: marquee-scroll 30s linear infinite;\n}\n\n.marquee-track.paused {\n  animation-play-state: paused;\n}\n\n.items-group {\n  display: flex;\n  align-items: center;\n  gap: 4rem; /* ระยะห่างระหว่างประกาศ */\n  padding-right: 4rem; /* ระยะห่างตอนจบกลุ่มเพื่อเริ่มกลุ่มใหม่ */\n}\n\n.floating-item {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  white-space: nowrap;\n}\n\n.text-icon { font-size: 1.5rem; }\n\nh4, p, span { margin: 0; font-family: sans-serif; }\n\n.highlight { color: #f1c40f; font-weight: bold; text-shadow: 0 0 10px rgba(241, 196, 15, 0.5); }\n.info { color: #2ecc71; }\n\n/* ปุ่มปิดด้านขวา */\n.close-banner {\n  background: rgba(255,255,255,0.1);\n  border: none;\n  color: white;\n  font-size: 24px;\n  cursor: pointer;\n  height: 100%;\n  padding: 0 15px;\n  transition: all 0.3s;\n  z-index: 10;\n}\n.close-banner:hover { background: #e74c3c; }\n\n@keyframes marquee-scroll {\n  0% { transform: translateX(0); }\n  100% { transform: translateX(-50%); } /* เลื่อนไปครึ่งทางเพราะเรามี 2 ชุดที่ซ้ำกัน */\n}\n\n/* Slide Transition */\n.banner-slide-enter-active, .banner-slide-leave-active {\n  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.banner-slide-enter-from, .banner-slide-leave-to {\n  transform: translateY(-100%);\n}\n\n@media (max-width: 768px) {\n  .announcement-banner { height: 50px; }\n  .items-group { gap: 2rem; padding-right: 2rem; }\n  .marquee-track { animation-duration: 20s; } /* บนมือถือสั้นกว่า เลื่อนเร็วกว่านิดหน่อย */\n}\n</style>"],"mappings":"AAuCA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAI;;;;;;;;;;;;;;;;IAFnC;;IAIA,MAAMC,KAAK,GAAGC,OAAA;IAKd,MAAMC,SAAS,GAAGJ,GAAG,CAAC,IAAI;IAC1B,MAAMK,QAAQ,GAAGL,GAAG,CAAC,KAAK;IAE1B,MAAMM,iBAAiB,GAAGN,GAAG,CAAC,CAC5B;MAAEO,IAAI,EAAE,IAAI;MAAEC,IAAI,EAAE,yBAAyB;MAAEC,GAAG,EAAE,IAAI;MAAEC,IAAI,EAAE;IAAG,CAAC,EACpE;MAAEH,IAAI,EAAE,IAAI;MAAEC,IAAI,EAAE,yBAAyB;MAAEC,GAAG,EAAE,GAAG;MAAEC,IAAI,EAAE;IAAG,CAAC,EACnE;MAAEH,IAAI,EAAE,GAAG;MAAEC,IAAI,EAAE,iCAAiC;MAAEC,GAAG,EAAE,MAAM;MAAEC,IAAI,EAAE;IAAY,CAAC,EACtF;MAAEH,IAAI,EAAE,IAAI;MAAEC,IAAI,EAAE,kCAAkC;MAAEC,GAAG,EAAE,MAAM;MAAEC,IAAI,EAAE;IAAO,EACnF;IAED,MAAMC,WAAW,GAAGA,CAAA,KAAM;MACxBP,SAAS,CAACQ,KAAK,GAAG,KAAI;MACtBC,YAAY,CAACC,OAAO,CAAC,0BAA0B,EAAE,MAAM;IACzD;IAEA,MAAMC,UAAU,GAAGA,CAAA,KAAM;MACvBX,SAAS,CAACQ,KAAK,GAAG,IAAG;MACrBC,YAAY,CAACG,UAAU,CAAC,0BAA0B;IACpD;IAEAf,SAAS,CAAC,MAAM;MACd,IAAIY,YAAY,CAACI,OAAO,CAAC,0BAA0B,CAAC,KAAK,MAAM,EAAE;QAC/Db,SAAS,CAACQ,KAAK,GAAG,KAAI;MACxB;MACA,IAAIV,KAAK,CAACgB,QAAQ,EAAE;QAClBC,UAAU,CAACR,WAAW,EAAET,KAAK,CAACkB,SAAS;MACzC;IACF,CAAC;IAEDC,QAAY,CAAC;MAAEN,UAAU;MAAEJ;IAAY,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}