{"ast":null,"code":"import { createElementVNode as _createElementVNode, toDisplayString as _toDisplayString, openBlock as _openBlock, createElementBlock as _createElementBlock, createCommentVNode as _createCommentVNode, Transition as _Transition, withCtx as _withCtx, createBlock as _createBlock } from \"vue\";\nconst _hoisted_1 = {\n  key: 0,\n  class: \"announcement-banner\"\n};\nconst _hoisted_2 = {\n  class: \"banner-content\"\n};\nconst _hoisted_3 = {\n  class: \"banner-text\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createBlock(_Transition, {\n    name: \"banner-slide\"\n  }, {\n    default: _withCtx(() => [$setup.isVisible ? (_openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createElementVNode(\"div\", _hoisted_2, [_cache[0] || (_cache[0] = _createElementVNode(\"div\", {\n      class: \"banner-icon\"\n    }, [_createElementVNode(\"i\", {\n      class: \"pi pi-megaphone\"\n    })], -1 /* CACHED */)), _createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"h4\", null, _toDisplayString($props.title), 1 /* TEXT */), _createElementVNode(\"p\", null, _toDisplayString($props.message), 1 /* TEXT */)])])])) : _createCommentVNode(\"v-if\", true)]),\n    _: 1 /* STABLE */\n  });\n}","map":{"version":3,"names":["class","_createBlock","_Transition","name","$setup","isVisible","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","_toDisplayString","$props","title","message"],"sources":["D:\\frontend_cem\\src\\components\\AnnouncementBanner.vue"],"sourcesContent":["<template>\n  <transition name=\"banner-slide\">\n    <div v-if=\"isVisible\" class=\"announcement-banner\">\n      <div class=\"banner-content\">\n        <div class=\"banner-icon\">\n          <i class=\"pi pi-megaphone\"></i>\n        </div>\n        <div class=\"banner-text\">\n          <h4>{{ title }}</h4>\n          <p>{{ message }}</p>\n        </div>\n      </div>\n    </div>\n  </transition>\n</template>\n\n<script setup>\n/* eslint-disable */\nimport { ref, onMounted } from 'vue'\n\nconst props = defineProps({\n  title: {\n    type: String,\n    default: 'ประกาศ'\n  },\n  message: {\n    type: String,\n    default: 'ข้อความประกาศของคุณ'\n  },\n  autoHide: {\n    type: Boolean,\n    default: false\n  },\n  hideDelay: {\n    type: Number,\n    default: 5000\n  }\n})\n\nconst isVisible = ref(true)\n\nconst closeBanner = () => {\n  isVisible.value = false\n  // บันทึกสถานะการปิดลง localStorage\n  localStorage.setItem('announcementBannerClosed', 'true')\n}\n\nconst showBanner = () => {\n  isVisible.value = true\n  localStorage.removeItem('announcementBannerClosed')\n}\n\nonMounted(() => {\n  // เช็คว่าผู้ใช้เคยปิดป้ายประกาศไปหรือไม่\n  const wasClosed = localStorage.getItem('announcementBannerClosed')\n  if (wasClosed === 'true') {\n    isVisible.value = false\n  }\n\n  // ถ้าตั้งค่าให้ซ่อนอัตโนมัติ\n  if (props.autoHide) {\n    setTimeout(() => {\n      closeBanner()\n    }, props.hideDelay)\n  }\n})\n\n// เปิดให้ component อื่นเรียกใช้\ndefineExpose({\n  showBanner,\n  closeBanner\n})\n</script>\n\n<style scoped>\n.announcement-banner {\n  background: linear-gradient(135deg, rgba(74, 144, 226, 0.85) 0%, rgba(215, 53, 39, 0.85) 100%);\n  color: white;\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1100;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);\n  backdrop-filter: blur(12px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.2);\n  animation: bannerGlow 3s ease-in-out infinite alternate;\n}\n\n@keyframes bannerGlow {\n  0% {\n    box-shadow: 0 4px 20px rgba(74, 144, 226, 0.15);\n  }\n  100% {\n    box-shadow: 0 4px 25px rgba(215, 53, 39, 0.2);\n  }\n}\n\n.banner-content {\n  display: flex;\n  align-items: center;\n  padding: 0 3rem;\n  gap: 1.5rem;\n  max-width: 100%;\n  height: 70px;\n}\n\n.banner-icon {\n  flex-shrink: 0;\n  font-size: 2rem;\n  animation: pulse 2s infinite;\n}\n\n.banner-text {\n  flex: 1;\n  min-width: 0;\n}\n\n.banner-text h4 {\n  margin: 0 0 0.5rem 0;\n  font-size: 1.25rem;\n  font-weight: 600;\n}\n\n.banner-text p {\n  margin: 0;\n  font-size: 1rem;\n  opacity: 0.9;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n/* Animation */\n.banner-slide-enter-active,\n.banner-slide-leave-active {\n  transition: all 0.3s ease;\n}\n\n.banner-slide-enter-from {\n  transform: translateY(-100%);\n}\n\n.banner-slide-leave-to {\n  transform: translateY(-100%);\n}\n\n@keyframes pulse {\n  0% {\n    transform: scale(1);\n  }\n  50% {\n    transform: scale(1.1);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .banner-content {\n    padding: 0.75rem 1rem;\n  }\n  \n  .banner-icon {\n    font-size: 1.25rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 0.875rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.75rem;\n  }\n}\n\n@media (max-width: 480px) {\n  .banner-content {\n    padding: 0.5rem 0.75rem;\n    gap: 0.5rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 0.8rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.7rem;\n  }\n}\n</style>\n"],"mappings":";;;EAE0BA,KAAK,EAAC;;;EACrBA,KAAK,EAAC;AAAgB;;EAIpBA,KAAK,EAAC;AAAa;;uBAN9BC,YAAA,CAYaC,WAAA;IAZDC,IAAI,EAAC;EAAc;sBAC7B,MAUM,CAVKC,MAAA,CAAAC,SAAS,I,cAApBC,mBAAA,CAUM,OAVNC,UAUM,GATJC,mBAAA,CAQM,OARNC,UAQM,G,0BAPJD,mBAAA,CAEM;MAFDR,KAAK,EAAC;IAAa,IACtBQ,mBAAA,CAA+B;MAA5BR,KAAK,EAAC;IAAiB,G,qBAE5BQ,mBAAA,CAGM,OAHNE,UAGM,GAFJF,mBAAA,CAAoB,YAAAG,gBAAA,CAAbC,MAAA,CAAAC,KAAK,kBACZL,mBAAA,CAAoB,WAAAG,gBAAA,CAAdC,MAAA,CAAAE,OAAO,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}