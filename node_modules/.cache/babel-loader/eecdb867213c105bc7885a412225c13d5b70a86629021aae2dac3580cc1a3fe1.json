{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  __name: 'AnnouncementInput',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const isExpanded = ref(false);\n    const isSubmitting = ref(false);\n    const successMessage = ref('');\n    const errorMessage = ref('');\n    const newAnnouncement = ref({\n      icon: '📢',\n      text: '',\n      type: ''\n    });\n    const toggleInput = () => {\n      isExpanded.value = !isExpanded.value;\n      if (!isExpanded.value) {\n        clearForm();\n      }\n    };\n    const clearForm = () => {\n      newAnnouncement.value = {\n        icon: '📢',\n        text: '',\n        type: ''\n      };\n      successMessage.value = '';\n      errorMessage.value = '';\n    };\n    const submitAnnouncement = async () => {\n      if (!newAnnouncement.value.text.trim()) {\n        errorMessage.value = 'กรุณากรอกข้อความประกาศ';\n        return;\n      }\n      isSubmitting.value = true;\n      errorMessage.value = '';\n      try {\n        // ส่งข้อมูลไปยัง API\n        const response = await fetch('/api/announcements', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            icon: newAnnouncement.value.icon,\n            text: newAnnouncement.value.text,\n            type: newAnnouncement.value.type,\n            tag: 'h4' // กำหนด tag เป็น h4 เสมอ\n          })\n        });\n        if (response.ok) {\n          successMessage.value = 'บันทึกประกาศเรียบร้อยแล้ว!';\n          clearForm();\n\n          // ปิดช่องพิมพ์หลังจากบันทึกสำเร็จ\n          setTimeout(() => {\n            isExpanded.value = false;\n            successMessage.value = '';\n          }, 2000);\n        } else {\n          throw new Error('ไม่สามารถบันทึกประกาศได้');\n        }\n      } catch (error) {\n        console.error('Error submitting announcement:', error);\n        errorMessage.value = 'เกิดข้อผิดพลาด กรุณาลองใหม่';\n      } finally {\n        isSubmitting.value = false;\n      }\n    };\n    const __returned__ = {\n      isExpanded,\n      isSubmitting,\n      successMessage,\n      errorMessage,\n      newAnnouncement,\n      toggleInput,\n      clearForm,\n      submitAnnouncement,\n      ref\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","isExpanded","isSubmitting","successMessage","errorMessage","newAnnouncement","icon","text","type","toggleInput","value","clearForm","submitAnnouncement","trim","response","fetch","method","headers","body","JSON","stringify","tag","ok","setTimeout","Error","error","console"],"sources":["D:/frontend_cem/src/components/AnnouncementInput.vue"],"sourcesContent":["<template>\n  <div class=\"announcement-input-container\">\n    <button \n      class=\"announcement-toggle-btn\"\n      @click=\"toggleInput\"\n      :class=\"{ 'active': isExpanded }\"\n    >\n      <i class=\"pi pi-megaphone\"></i>\n    </button>\n    \n    <transition name=\"slide-up\">\n      <div v-if=\"isExpanded\" class=\"announcement-input-panel\">\n        <div class=\"input-header\">\n          <h3>เพิ่มประกาศใหม่</h3>\n          <button class=\"close-btn\" @click=\"toggleInput\">×</button>\n        </div>\n        \n        <div class=\"input-form\">\n          <div class=\"form-group\">\n            <label>ไอคอน:</label>\n            <select v-model=\"newAnnouncement.icon\" class=\"icon-select\">\n              <option value=\"📢\">📢 ประกาศ</option>\n              <option value=\"⚠️\">⚠️ เตือน</option>\n              <option value=\"✨\">✨ ใหม่</option>\n              <option value=\"🚀\">🚀 อัปเดต</option>\n              <option value=\"📅\">📅 กำหนดการ</option>\n              <option value=\"🎉\">🎉 สำเร็จ</option>\n            </select>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ข้อความ:</label>\n            <textarea \n              v-model=\"newAnnouncement.text\"\n              placeholder=\"กรอกข้อความประกาศ...\"\n              class=\"message-textarea\"\n              rows=\"3\"\n            ></textarea>\n          </div>\n          \n          <div class=\"form-group\">\n            <label>ประเภท:</label>\n            <select v-model=\"newAnnouncement.type\" class=\"type-select\">\n              <option value=\"\">ปกติ</option>\n              <option value=\"highlight\">โดดเด่น</option>\n              <option value=\"warning\">เตือน</option>\n              <option value=\"info\">ข้อมูล</option>\n            </select>\n          </div>\n          \n          <div class=\"form-actions\">\n            <button \n              @click=\"submitAnnouncement\"\n              class=\"submit-btn\"\n              :disabled=\"!newAnnouncement.text.trim() || isSubmitting\"\n            >\n              <span v-if=\"isSubmitting\">กำลังบันทึก...</span>\n              <span v-else>บันทึกประกาศ</span>\n            </button>\n            <button @click=\"clearForm\" class=\"clear-btn\">ล้าง</button>\n          </div>\n        </div>\n        \n        <div v-if=\"successMessage\" class=\"success-message\">\n          {{ successMessage }}\n        </div>\n        \n        <div v-if=\"errorMessage\" class=\"error-message\">\n          {{ errorMessage }}\n        </div>\n      </div>\n    </transition>\n  </div>\n</template>\n\n<script setup>\nimport { ref } from 'vue'\n\nconst isExpanded = ref(false)\nconst isSubmitting = ref(false)\nconst successMessage = ref('')\nconst errorMessage = ref('')\n\nconst newAnnouncement = ref({\n  icon: '📢',\n  text: '',\n  type: ''\n})\n\nconst toggleInput = () => {\n  isExpanded.value = !isExpanded.value\n  if (!isExpanded.value) {\n    clearForm()\n  }\n}\n\nconst clearForm = () => {\n  newAnnouncement.value = {\n    icon: '📢',\n    text: '',\n    type: ''\n  }\n  successMessage.value = ''\n  errorMessage.value = ''\n}\n\nconst submitAnnouncement = async () => {\n  if (!newAnnouncement.value.text.trim()) {\n    errorMessage.value = 'กรุณากรอกข้อความประกาศ'\n    return\n  }\n  \n  isSubmitting.value = true\n  errorMessage.value = ''\n  \n  try {\n    // ส่งข้อมูลไปยัง API\n    const response = await fetch('/api/announcements', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json',\n      },\n      body: JSON.stringify({\n        icon: newAnnouncement.value.icon,\n        text: newAnnouncement.value.text,\n        type: newAnnouncement.value.type,\n        tag: 'h4' // กำหนด tag เป็น h4 เสมอ\n      })\n    })\n    \n    if (response.ok) {\n      successMessage.value = 'บันทึกประกาศเรียบร้อยแล้ว!'\n      clearForm()\n      \n      // ปิดช่องพิมพ์หลังจากบันทึกสำเร็จ\n      setTimeout(() => {\n        isExpanded.value = false\n        successMessage.value = ''\n      }, 2000)\n    } else {\n      throw new Error('ไม่สามารถบันทึกประกาศได้')\n    }\n  } catch (error) {\n    console.error('Error submitting announcement:', error)\n    errorMessage.value = 'เกิดข้อผิดพลาด กรุณาลองใหม่'\n  } finally {\n    isSubmitting.value = false\n  }\n}\n</script>\n\n<style scoped>\n.announcement-input-container {\n  position: fixed;\n  bottom: 24px;\n  right: 24px;\n  z-index: 1000;\n}\n\n.announcement-toggle-btn {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border: none;\n  border-radius: 50%;\n  padding: 12px;\n  cursor: pointer;\n  font-size: 24px;\n  font-weight: 600;\n  box-shadow: 0 4px 15px rgba(74, 144, 226, 0.4);\n  transition: transform 0.2s;\n  backdrop-filter: blur(10px);\n  width: 56px;\n  height: 56px;\n}\n\n.announcement-toggle-btn:hover {\n  transform: scale(1.1);\n  box-shadow: 0 6px 16px rgba(74, 144, 226, 0.4);\n}\n\n.announcement-toggle-btn.active {\n  background: linear-gradient(135deg, #d73527 0%, #4a90e2 100%);\n}\n\n.announcement-toggle-btn i {\n  font-size: 24px;\n}\n\n.announcement-input-panel {\n  position: absolute;\n  bottom: 60px;\n  right: 0;\n  background: white;\n  border-radius: 12px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\n  width: 320px;\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.input-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  border-bottom: 1px solid #e0e0e0;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border-radius: 12px 12px 0 0;\n}\n\n.input-header h3 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.close-btn {\n  background: transparent;\n  border: none;\n  color: white;\n  font-size: 20px;\n  cursor: pointer;\n  padding: 4px 8px;\n  border-radius: 4px;\n  transition: background-color 0.3s ease;\n}\n\n.close-btn:hover {\n  background-color: rgba(255, 255, 255, 0.2);\n}\n\n.input-form {\n  padding: 16px;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 6px;\n  font-size: 14px;\n  font-weight: 500;\n  color: #333;\n}\n\n.icon-select,\n.type-select {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  font-size: 14px;\n  background: white;\n}\n\n.message-textarea {\n  width: 100%;\n  padding: 8px 12px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  font-size: 14px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.message-textarea:focus {\n  outline: none;\n  border-color: #4a90e2;\n  box-shadow: 0 0 0 2px rgba(74, 144, 226, 0.2);\n}\n\n.form-actions {\n  display: flex;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.submit-btn {\n  flex: 1;\n  background: linear-gradient(135deg, #4a90e2 0%, #d73527 100%);\n  color: white;\n  border: none;\n  border-radius: 6px;\n  padding: 10px 16px;\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.submit-btn:hover:not(:disabled) {\n  transform: translateY(-1px);\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\n}\n\n.submit-btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.clear-btn {\n  background: #f5f5f5;\n  color: #666;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n  padding: 10px 16px;\n  font-size: 14px;\n  cursor: pointer;\n  transition: all 0.3s ease;\n}\n\n.clear-btn:hover {\n  background: #e0e0e0;\n}\n\n.success-message {\n  margin: 12px 16px;\n  padding: 8px 12px;\n  background: #d4edda;\n  color: #155724;\n  border-radius: 6px;\n  font-size: 14px;\n  text-align: center;\n}\n\n.error-message {\n  margin: 12px 16px;\n  padding: 8px 12px;\n  background: #f8d7da;\n  color: #721c24;\n  border-radius: 6px;\n  font-size: 14px;\n  text-align: center;\n}\n\n/* Animations */\n.slide-up-enter-active,\n.slide-up-leave-active {\n  transition: all 0.3s ease;\n}\n\n.slide-up-enter-from {\n  opacity: 0;\n  transform: translateY(20px);\n}\n\n.slide-up-leave-to {\n  opacity: 0;\n  transform: translateY(20px);\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .announcement-input-container {\n    bottom: 80px;\n    right: 10px;\n  }\n  \n  .announcement-input-panel {\n    width: 280px;\n  }\n}\n\n@media (max-width: 480px) {\n  .announcement-input-container {\n    bottom: 60px;\n    right: 5px;\n  }\n  \n  .announcement-input-panel {\n    width: 260px;\n  }\n  \n  .announcement-toggle-btn {\n    width: 56px;\n    height: 56px;\n    padding: 12px;\n  }\n  \n  .announcement-toggle-btn i {\n    font-size: 24px;\n  }\n}\n</style>\n"],"mappings":"AA4EA,SAASA,GAAG,QAAQ,KAAI;;;;;;;IAExB,MAAMC,UAAU,GAAGD,GAAG,CAAC,KAAK;IAC5B,MAAME,YAAY,GAAGF,GAAG,CAAC,KAAK;IAC9B,MAAMG,cAAc,GAAGH,GAAG,CAAC,EAAE;IAC7B,MAAMI,YAAY,GAAGJ,GAAG,CAAC,EAAE;IAE3B,MAAMK,eAAe,GAAGL,GAAG,CAAC;MAC1BM,IAAI,EAAE,IAAI;MACVC,IAAI,EAAE,EAAE;MACRC,IAAI,EAAE;IACR,CAAC;IAED,MAAMC,WAAW,GAAGA,CAAA,KAAM;MACxBR,UAAU,CAACS,KAAK,GAAG,CAACT,UAAU,CAACS,KAAI;MACnC,IAAI,CAACT,UAAU,CAACS,KAAK,EAAE;QACrBC,SAAS,CAAC;MACZ;IACF;IAEA,MAAMA,SAAS,GAAGA,CAAA,KAAM;MACtBN,eAAe,CAACK,KAAK,GAAG;QACt