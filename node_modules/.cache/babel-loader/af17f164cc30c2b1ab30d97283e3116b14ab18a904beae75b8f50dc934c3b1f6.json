์ 2026</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </transition>\n</template>\n\n<script setup>\n/* eslint-disable */\nimport { ref, onMounted } from 'vue'\n\nconst props = defineProps({\n  title: {\n    type: String,\n    default: 'ประกาศ'\n  },\n  message: {\n    type: String,\n    default: 'ข้อความประกาศของคุณ'\n  },\n  autoHide: {\n    type: Boolean,\n    default: false\n  },\n  hideDelay: {\n    type: Number,\n    default: 5000\n  }\n})\n\nconst isVisible = ref(true)\n\nconst closeBanner = () => {\n  isVisible.value = false\n  // บันทึกสถานะการปิดลง localStorage\n  localStorage.setItem('announcementBannerClosed', 'true')\n}\n\nconst showBanner = () => {\n  isVisible.value = true\n  localStorage.removeItem('announcementBannerClosed')\n}\n\nonMounted(() => {\n  // เช็คว่าผู้ใช้เคยปิดป้ายประกาศไปหรือไม่\n  const wasClosed = localStorage.getItem('announcementBannerClosed')\n  if (wasClosed === 'true') {\n    isVisible.value = false\n  }\n\n  // ถ้าตั้งค่าให้ซ่อนอัตโนมัติ\n  if (props.autoHide) {\n    setTimeout(() => {\n      closeBanner()\n    }, props.hideDelay)\n  }\n})\n\n// เปิดให้ component อื่นเรียกใช้\ndefineExpose({\n  showBanner,\n  closeBanner\n})\n</script>\n\n<style scoped>\n.announcement-banner {\n  background: linear-gradient(135deg, rgba(74, 144, 226, 0.95) 0%, rgba(215, 53, 39, 0.95) 100%);\n  color: white;\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 1100;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\n  backdrop-filter: blur(16px);\n  border-bottom: 2px solid rgba(255, 255, 255, 0.4);\n  height: 80px;\n}\n\n.banner-content {\n  display: flex;\n  align-items: center;\n  padding: 0;\n  gap: 0;\n  max-width: 100%;\n  height: 80px;\n  width: 100%;\n}\n\n.banner-text-container {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  position: relative;\n  width: 100%;\n}\n\n.banner-text-wrapper {\n  display: flex;\n  animation: scrollText 20s linear infinite;\n  width: max-content;\n}\n\n.banner-text {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n  padding-right: 8rem;\n}\n\n.banner-text.clone {\n  display: flex;\n  align-items: center;\n  gap: 2rem;\n  white-space: nowrap;\n}\n\n.text-icon {\n  font-size: 1.8rem;\n}\n\n.banner-text h4 {\n  margin: 0;\n  font-size: 1.5rem;\n  font-weight: 700;\n  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);\n  letter-spacing: 0.8px;\n  color: white;\n}\n\n.banner-text p {\n  margin: 0;\n  font-size: 1.3rem;\n  text-shadow: 0 3px 6px rgba(0, 0, 0, 0.4);\n  color: rgba(255, 255, 255, 0.95);\n}\n\n.separator {\n  font-size: 1.8rem;\n  font-weight: bold;\n  opacity: 0.8;\n}\n\n.highlight {\n  font-size: 1.3rem;\n  font-weight: 600;\n  color: #ffeb3b;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);\n  animation: highlightPulse 2s ease-in-out infinite;\n}\n\n.info {\n  font-size: 1.2rem;\n  color: #81c784;\n  text-shadow: 0 2px 4px rgba(0, 0, 0, 0.4);\n}\n\n@keyframes highlightPulse {\n  0%, 100% {\n    opacity: 0.9;\n    transform: scale(1);\n  }\n  50% {\n    opacity: 1;\n    transform: scale(1.05);\n  }\n}\n\n@keyframes scrollText {\n  0% {\n    transform: translateX(100vw);\n  }\n  100% {\n    transform: translateX(-100%);\n  }\n}\n.banner-slide-enter-active,\n.banner-slide-leave-active {\n  transition: all 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n.banner-slide-enter-from {\n  transform: translateY(-100%) rotateX(-90deg);\n  opacity: 0;\n}\n\n.banner-slide-leave-to {\n  transform: translateY(-100%) rotateX(90deg);\n  opacity: 0;\n}\n\n/* Responsive */\n@media (max-width: 768px) {\n  .banner-content {\n    padding: 0 1rem;\n  }\n  \n  .banner-text {\n    gap: 1.5rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 1.1rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.9rem;\n  }\n  \n  .text-icon {\n    font-size: 1.2rem;\n  }\n  \n  .separator {\n    font-size: 1.2rem;\n  }\n}\n\n@media (max-width: 480px) {\n  .banner-content {\n    padding: 0 0.75rem;\n  }\n  \n  .banner-text {\n    gap: 1rem;\n  }\n  \n  .banner-text h4 {\n    font-size: 1rem;\n  }\n  \n  .banner-text p {\n    font-size: 0.8rem;\n  }\n  \n  .text-icon {\n    font-size: 1rem;\n  }\n  \n  .separator {\n    font-size: 1rem;\n  }\n}\n</style>\n"],"mappings":";;;EAE0BA,KAAK,EAAC;;;uBAD9BC,YAAA,CA6BaC,WAAA;IA7BDC,IAAI,EAAC;EAAc;sBAC7B,MA2BM,CA3BKC,MAAA,CAAAC,SAAS,I,cAApBC,mBAAA,CA2BM,OA3BNC,UA2BM,OAAAC,MAAA,QAAAA,MAAA,OA1BJC,mBAAA,CAyBM;MAzBDT,KAAK,EAAC;IAAgB,IACzBS,mBAAA,CAuBM;MAvBDT,KAAK,EAAC;IAAuB,IAChCS,mBAAA,CAqBM;MArBDT,KAAK,EAAC;IAAqB,IAC9BS,mBAAA,CASM;MATDT,KAAK,EAAC;IAAa,IACtBS,mBAAA,CAAiC;MAA3BT,KAAK,EAAC;IAAW,GAAC,IAAE,GAC1BS,mBAAA,CAAmC,YAA/B,4BAA0B,GAC9BA,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAAoD,WAAjD,+CAA6C,GAChDA,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAAgE;MAA1DT,KAAK,EAAC;IAAW,GAAC,mCAAiC,GACzDS,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAA6D;MAAvDT,KAAK,EAAC;IAAM,GAAC,qCAAmC,E,GAExDS,mBAAA,CASM;MATDT,KAAK,EAAC;IAAmB,IAC5BS,mBAAA,CAAiC;MAA3BT,KAAK,EAAC;IAAW,GAAC,IAAE,GAC1BS,mBAAA,CAAmC,YAA/B,4BAA0B,GAC9BA,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAAoD,WAAjD,+CAA6C,GAChDA,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAAgE;MAA1DT,KAAK,EAAC;IAAW,GAAC,mCAAiC,GACzDS,mBAAA,CAAgC;MAA1BT,KAAK,EAAC;IAAW,GAAC,GAAC,GACzBS,mBAAA,CAA6D;MAAvDT,KAAK,EAAC;IAAM,GAAC,qCAAmC,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}